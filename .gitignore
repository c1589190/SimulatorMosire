# 构建产物
target/
*.class

# IDE
.idea/
*.iml
.vscode/

# Eclipse / m2e —— 全部由 pom.xml 派生，可随时重新生成，不进仓库
.project
.classpath
.factorypath
.settings/

# Claude Code —— 本机专用，不进仓库（官方要求）
CLAUDE.local.md
**/.claude/settings.local.json
.claude/agent-memory-local/

# ★ 工作树统一目录（用户 2026-10-23 裁定：未来 worktree 全部放顶层 worktree/，
#   不再使用 .claude/worktrees 名号）。每棵都是整仓副本（内含 .git 文件与 target/），
#   一旦入库就是把整个仓库再塞一份；忽略 ≠ 删除，git worktree list 仍看得见它们。
/worktree/

# 历史 worktree 曾放 .claude/worktrees/；2026-10-23 已迁出，不再作为新树落点。

# 会话原始记录 —— 内容已消化进 spec/计划，留本地作溯源，不进版本库
*-gsimulator.txt

# Maven 串行化锁（tools/mvn-lock.sh 用；放在仓根以便不受 clean 影响）
.mvn-lock.d/
.mvn-lock.d.worktrees/
.git/.mvn-lock.d/

# ★★ 每棵工作树【自己的】Maven 本地仓库（tools/mvn-lock.sh 首次用时用 `cp -al` 从 ~/.m2/repository
#   hardlink 播种；实测 8267 文件 / 表观 736M，**真实占用仅 11 MB**）⇒ 跨树编译**不再争 ~/.m2**。
#   ★ 必须忽略：否则 8267 个文件会污染 git status。
.m2-repo/

# omo/codegraph 运行时（会话延续 + 代码图缓存）—— 本机专用，可随时重建，不进仓库
.omo/

# Python 字节码（脚本目录下自动生成，可重建）
__pycache__/
*.pyc

# 代码测试世界（18Lvt 副本；运行产物，不入库；见 test-world/README.md 与 AGENTS.md §8.7）
/test-world/

# P1.4 小世界演示的独立 store（run/small-world-db 等；运行产物，不入库）
/run/
