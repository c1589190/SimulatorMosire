<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.mosire</groupId>
    <artifactId>simos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>simos-unit</artifactId>
  <name>UnitSimos</name>
  <description>军事单位：编制树、装备与人数、位置继承、基于通行成本的移动与寻路。</description>

  <dependencies>
    <!-- ★ D5：门禁若在本地类型上报 EI_EXPOSE_REP 类误报，@SuppressFBWarnings 注解住在这里
         （version 与 spotbugs 插件同代；照 social-api/economy-api 的先例）。 -->
    <dependency>
      <groupId>com.github.spotbugs</groupId><artifactId>spotbugs-annotations</artifactId>
      <version>4.10.4</version><scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-util</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-map</artifactId>
    </dependency>
    <!-- ★★ 2026-10-12 B3 第五域（unit 工具下放，设计书 §4.1/§4.3）：本域的工具实现落在
         `io.mosire.simos.unit.tools.{read,write}`，只依赖**工具契约层**（工具接口/角色标签/GM-only 标签/窄写口/
         资源与 schema 助手），**不依赖 `simos-ga`**（`ga` 必须认识各域 ⇒ 域再依赖它当场成环，Maven 建图期直接拒）。
         本批只加这一条：其余允许面（util/map/social-api/social）与禁列一字未动。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-ga-spi</artifactId>
    </dependency>
    <!-- ★ S3a（2026-10-09 Unit/Gov 家户容纳 §3）：unit 直接 import social-api 的 HouseholdId 等稳定 ID，
         按"依赖传递不是契约"继续显式声明这份**更上游的低层身份契约**。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-social-api</artifactId>
    </dependency>
    <!-- ★ 方案 A（2026-10-09 用户裁定）：Social 是人员/家户的唯一域，业务模块允许**大方直连**
         `simos-social` 实现（家户状态 + 人员流动服务/工单受理口），不再只走 social-api 这道旧门。
         版本由父 POM 的 dependencyManagement 提供。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-social</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId><artifactId>assertj-core</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-module-boundaries</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <!-- ★★ 2026-10-12 闭合（用户裁定「冻结各个模块的语义，确保下次改不越界」）：本仓的边界语义 = 「本模块不许**直接声明**某个依赖」；传递可见是 Maven 依赖图的事实、本模块控制不了 ⇒ 显式关掉传递检查（enforcer 3.6.3 `searchTransitive` 默认 true，字节码核实）。禁列全仓 simos 模块 − 自己 − 允许面，零例外。 -->
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                    <exclude>io.mosire:simos-core</exclude>
                    <exclude>io.mosire:agentlib-mosire</exclude>
                    <!-- ★ Task 10 回填（AGENTS.md §〇 点名的欠账：本表停在 M0，此后新增模块从未回填）：
                         actor 与 unit 是**兄弟切片**（actor 的 `ActorKind.UNIT` 只是个不透明种类串，
                         不 import 任何单位类型）⇒ 互不依赖由构建期强制。
                         ★ `simos-actor-api` **不在此列**（契约层，与 `economy-api` 同待遇）。 -->
                    <exclude>io.mosire:simos-actor</exclude>
                    <!-- ★ 2026-10-09 方案 A（用户裁定）：原 `exclude simos-social` 已删——
                         Social 是人员/家户的唯一域，unit 允许**直接依赖 simos-social 实现**；
                         更上游的 `simos-social-api` 低层身份契约仍显式声明、不在禁列。 -->
                    <!-- ★★ 2026-10-12 模块语义冻结（文档 §3）：对称闭合
                         = 禁掉"本模块 + 允许面（util/map/social-api/social）之外"的全部 simos 模块。
                         ★ 上方 Task 10 那段"`simos-actor-api` 不在此列（契约层）"的口径**已被本次冻结取代**
                         （原文保留作留痕）。★ `simos-ledger` 已退役、当前无同名模块：照冻结表列入。
                         ★★ **传递依赖例外（2026-10-12 实测，两条）**：冻结表 §3 把 `simos-actor-api` 与
                         `simos-economy-api` 也列进本模块禁列，但这两条**加不进来**——enforcer 3.6.3 的
                         `searchTransitive` 默认为 true ⇒ 禁列查传递依赖，而实测链是：
                             simos-unit → simos-social → simos-economy-api → simos-actor-api
                         （`unit` 显式声明 `simos-social`，social 显式声明 `simos-economy-api`，
                          economy-api 显式声明 `simos-actor-api`）⇒ 两条同时被点名、`validate` 当场红。
                         ★ 冻结文档 §4 I-F2 禁止加 `<includes>` 白名单绕过 ⇒ 此处**不列**这两条；
                         它们在"允许面"里的归属应由冻结表重算（另裁），本处只留链与理由。 -->
                    <exclude>io.mosire:simos-app</exclude>
                    <exclude>io.mosire:simos-army</exclude>
                    <exclude>io.mosire:simos-economy</exclude>
                    <exclude>io.mosire:simos-gov</exclude>
                    <!-- ★★ 2026-10-12 B2a（设计书 §4.1 / §5 I-G2）：运行框架 simos-ga（工具运作 + 决策人运行）——
                         它永不依赖 app，其余模块也不得依赖它 ⇒ 列入禁列（组合根 simos-app 是唯一认识它的地方）。 -->
                    <exclude>io.mosire:simos-ga</exclude>
                    <exclude>io.mosire:simos-ledger</exclude>
                    <exclude>io.mosire:simos-actor-api</exclude>
                    <exclude>io.mosire:simos-calendar</exclude>
                    <exclude>io.mosire:simos-economy-api</exclude>
                  </excludes>
                  <message>simos-unit 是编制树与单位（不依赖社会实现）：只许依赖 util/map/social-api/social + 工具契约层 ga-spi；禁列 = 全仓 simos 模块 − 自己 − 允许面（含 actor/app/army/economy/gov/core、运行框架 ga 与已退役的 ledger；`simos-sd` 已于 2026-10-12 整模块退役）。★ 例外：actor-api 与 economy-api 由 social → economy-api → actor-api 传递带出、calendar 由 social 传递带出，三条按 I-F1 不入禁列（见上方传递依赖例外注）；ga-spi 不在禁列（组合根与契约层，5 个模块按冻结文档 §4 I-F4 列了它，本模块不在其中）。</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
