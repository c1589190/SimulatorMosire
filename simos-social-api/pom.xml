<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.mosire</groupId>
    <artifactId>simos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>simos-social-api</artifactId>
  <name>SocialApiSimos</name>
  <description>低层人口/家户身份契约（更上游的稳定 ID + 只读 SPI）：家户/人口稳定 ID（HouseholdId / PeopleLotId）、性别人口词表（Sex）、家户位置/画像、人口年龄档与出生死亡事件形状。无 Snapshot / ChangeSet / Codec；只依赖 map + jackson-annotations（类型注解），不依赖任何 simos 领域模块。★ 方案 A（2026-10-09 用户裁定）：本模块保留但降级为低层契约，`economy-api`/`actor` 可安全依赖它（破 `social ↔ economy-api` 环）；业务模块（unit/economy/gov/army/sd/app）直接依赖 `simos-social` 实现，本模块不再是跨模块家户访问的唯一门。</description>

  <!-- ★ 阶段 S1（2026-10-09 家户/人口架构 §3.1）：契约层只许依赖 map（HexCoord），
       不依赖任何 simos 领域模块。UUID/位置/人口事件的形状在这里定死，
       状态本体（Household / PopulationGroup / SocialData）仍住 simos-social。
       ★ 方案 A（2026-10-09 用户裁定）：本模块定位为**低层人口/家户身份契约**——保留是为了让
       `economy-api` / `actor` 这类更上游契约继续依赖它，避免 `economy-api → social → economy-api` 成环；
       业务模块对 Social 的直连走 `simos-social` 实现，不再被要求只走本模块。
       ★ 版本由父 POM 的 dependencyManagement 提供（"依赖传递不是契约"）。 -->
  <dependencies>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-map</artifactId>
    </dependency>
    <!-- ★ 2026-10-09 集成缺陷修复：Timeline 的全局 CHANGESET_MAPPER 看不见 social 模块 codec，
         而 HouseholdLocation 是 ChangeSet 嵌套字段里的 sealed 接口 ⇒ 类型本身必须带 @JsonTypeInfo/@JsonSubTypes，
         否则任何含家户位置的 revision 在 replay 时都因 abstract type 读不回来。
         只引 annotations（不带 databind），版本由父 POM 的 jackson-bom 给定。 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-annotations</artifactId>
    </dependency>
    <!-- 契约的往返/校验用例归后续测试阶段；此处按本仓 api 模块的既有形制预留测试依赖
         （scope=test 由父 POM dependencyManagement 给定）。 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId><artifactId>assertj-core</artifactId>
    </dependency>
    <!-- 与 actor-api/economy-api 同款：门禁若在本地类型上报 EI_EXPOSE_REP 类误报，
         @SuppressFBWarnings 的注解住在这里（version 与 spotbugs 插件同代）。 -->
    <dependency>
      <groupId>com.github.spotbugs</groupId><artifactId>spotbugs-annotations</artifactId>
      <version>4.10.4</version><scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-module-boundaries</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <!-- ★ 架构 §3.1：social-api 是契约层，只许依赖 map（HexCoord）与 jackson-annotations。
                         下列领域/编排模块一律禁（含反向依赖 social 本身与更底层的经济/actor 切片）。
                         ★ 方案 A（2026-10-09）：这张禁列管的是**本模块自己的依赖面**；反方向的
                         `economy-api → social-api` 与 `actor → social-api` 是明许的（破 social ↔ economy-api 环）。 -->
                    <exclude>io.mosire:simos-social</exclude>
                    <exclude>io.mosire:simos-unit</exclude>
                    <exclude>io.mosire:simos-economy-api</exclude>
                    <exclude>io.mosire:simos-economy</exclude>
                    <exclude>io.mosire:simos-actor</exclude>
                    <exclude>io.mosire:simos-actor-api</exclude>
                    <exclude>io.mosire:simos-sd</exclude>
                    <exclude>io.mosire:simos-core</exclude>
                    <exclude>io.mosire:simos-army</exclude>
                    <exclude>io.mosire:simos-gov</exclude>
                    <exclude>io.mosire:simos-app</exclude>
                    <exclude>io.mosire:agentlib-mosire</exclude>
                  </excludes>
                  <message>simos-social-api 是契约层（架构 §3.1）：只许依赖 simos-map（HexCoord；其 util 传递带 jackson-databind 是既有事实）与 jackson-annotations（类型注解），不许依赖任何 simos 领域/编排模块（social/unit/economy*/actor*/sd/core/army/gov/app/agentlib）。</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
