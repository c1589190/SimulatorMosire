<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.mosire</groupId>
    <artifactId>simos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>simos-map</artifactId>
  <name>MapSimos</name>
  <description>六边形网格地图：地形、区域、连通性、地形生成与寻址实现。不做任何存储——序列化上收到 CoreSimos。</description>

  <dependencies>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-util</artifactId>
    </dependency>
    <!-- ★★ 2026-10-12 B3 试点（设计书 docs/superpowers/specs/2026-10-12-ga-module-and-tool-descent.md
         §4.1/§4.3/§4.4；台账 §5 的执行顺序第 4 条「先 simos-map 15 个做试点」）：地图工具（`io.mosire.simos.map.tools.**`）
         住在**自己的域**里，靠这一条拿到工具契约层——工具接口/角色标签（`SimosTool`/`ToolRole`/`GmOnlyRead`）、
         窄写口（`ToolWritePort`）与两个纯助手（`ToolResources`/`ToolSchema`）。
         ★ 方向不变：`ga-spi → {util, agentlib}`，本模块**不依赖 core/app/任何领域模块**（下面的 enforcer 逐条强制）。
         ★ `agentlib-mosire`（AgentTool / ToolContext / ToolResult / ResourceManifest）**不在依赖块里**：
           enforcer 明禁直接声明它，工具经 `simos-ga-spi` 的**传递依赖**使用这些类型（本批唯一新增依赖 = 本块）。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-ga-spi</artifactId>
    </dependency>
    <!-- ★★ 2026-10-12 B3 试点补：地图工具面的窄写基类（`map/tools/write/AbstractNarrowWriteTool`）的构造器
         只做 `Objects.requireNonNull`（fail-closed），SpotBugs 的 `CT_CONSTRUCTOR_THROW` 对 `abstract` 类是
         **启发式误报** —— 处置沿用仓内既有形制（`simos-app/.../AbstractHouseholdGmTool:87` 的同一条
         `@SuppressFBWarnings`），故需要该注解。11 个模块都已这样声明（provided、不进产物，版本与 spotbugs 插件同代）。 -->
    <dependency>
      <groupId>com.github.spotbugs</groupId><artifactId>spotbugs-annotations</artifactId>
      <version>4.10.4</version><scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId><artifactId>assertj-core</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-module-boundaries</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <!-- ★★ 2026-10-12 闭合（用户裁定「冻结各个模块的语义，确保下次改不越界」）：本仓的边界语义 = 「本模块不许**直接声明**某个依赖」；传递可见是 Maven 依赖图的事实、本模块控制不了 ⇒ 显式关掉传递检查（enforcer 3.6.3 `searchTransitive` 默认 true，字节码核实）。禁列全仓 simos 模块 − 自己 − 允许面，零例外。 -->
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                    <exclude>io.mosire:simos-social</exclude>
                    <exclude>io.mosire:simos-unit</exclude>
                    <exclude>io.mosire:simos-core</exclude>
                    <exclude>io.mosire:agentlib-mosire</exclude>
                    <!-- ★ Task 10 回填（AGENTS.md §〇 点名的欠账：本表停在 M0，此后新增模块从未回填）：
                         `simos-actor` 依赖 map（产权"到格"⇒ 它的键就是 HexCoord），地图侧永远不知道切片存在。
                         ★ `simos-actor-api` **不在此列**（契约层，与 `economy-api` 同待遇）。 -->
                    <exclude>io.mosire:simos-actor</exclude>
                    <!-- ★ C1（2026-10-02，D-019）：防反向依赖 calendar（依赖方向 util → map → calendar）。 -->
                    <exclude>io.mosire:simos-calendar</exclude>
                    <!-- ★★ 2026-10-12 模块语义冻结（docs/superpowers/specs/2026-10-12-module-boundaries-freeze.md §3）：
                         对称闭合 = 禁掉"本模块 + 允许面（util）之外"的全部 simos 模块。
                         ★ 上方 Task 10 那段"`simos-actor-api` 不在此列（契约层）"的口径**已被本次冻结取代**
                         （原文保留作留痕）：地图侧永远不知道切片存在，契约层同禁。
                         ★ `simos-ledger` 已退役、当前无同名模块：照冻结表列入，作历史留痕与未来防线。 -->
                    <exclude>io.mosire:simos-actor-api</exclude>
                    <exclude>io.mosire:simos-app</exclude>
                    <exclude>io.mosire:simos-army</exclude>
                    <exclude>io.mosire:simos-economy</exclude>
                    <exclude>io.mosire:simos-economy-api</exclude>
                    <!-- ★★ 2026-10-12 B3 试点（设计书 §4.3/§4.4；台账 §5 的执行顺序）：`simos-ga-spi`
                         **从禁列除名** —— 地图的 15 个工具（`Map*`）已下放本模块（`io.mosire.simos.map.tools.**`），
                         它们必须看得见工具契约层。除名的依据：`ga-spi` 只依赖 `util` + `agentlib`，
                         **不引任何领域模块、不引 core**（它的 enforcer 逐条禁）⇒ 无环、不破铁律 3。
                         ★ B1（2026-10-12）本行原按冻结文档 §4 I-F4 列入，原注释保留作留痕：
                           「`simos-ga-spi` 是**工具契约层**（只依赖 util）——地图侧永远不知道工具面存在
                           （"地图工具"住在 app/未来的 map 工具包，不反向依赖契约层）」——该判断已被 B3 取代
                           （工具的家 = 它自己的域，正是本批要做的事）。 -->
                    <exclude>io.mosire:simos-gov</exclude>
                    <!-- ★★ 2026-10-12 B2a（设计书 §4.1 / §5 I-G2）：运行框架 simos-ga（工具运作 + 决策人运行）——
                         它永不依赖 app，其余模块也不得依赖它 ⇒ 列入禁列（组合根 simos-app 是唯一认识它的地方）。 -->
                    <exclude>io.mosire:simos-ga</exclude>
                    <exclude>io.mosire:simos-ledger</exclude>
                    <exclude>io.mosire:simos-social-api</exclude>
                    <!-- ★★ 2026-10-15 D-031 Z5（根 pom 16 → 18）：新增两模块均不在本模块允许面。 -->
                    <exclude>io.mosire:simos-culture</exclude>
                    <exclude>io.mosire:simos-production</exclude>
                  </excludes>
                  <message>simos-map 是地图与区域（地形/连通性/寻址），永不知道 SocialSimos / UnitSimos / ActorSimos 存在：只许依赖 simos-util 与 simos-ga-spi（工具契约层，只依赖 util —— 本模块的 15 个地图工具住在这里）。★ 禁列 = 全仓 simos 模块 − 自己 − {util, ga-spi}（含全部领域/编排模块与已退役的 ledger，作历史留痕与未来防线），也不依赖 AgentLibMosire、不做任何存储。 ★ 2026-10-15 D-031 Z5：新增 `simos-production` 与 `simos-culture` 两模块（根 pom 16 → 18）均不在本模块允许面，两条 exclude 同批补入。</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
