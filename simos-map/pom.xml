<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.mosire</groupId>
    <artifactId>simos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>simos-map</artifactId>
  <name>MapSimos</name>
  <description>六边形网格地图：地形、区域、连通性、地形生成与寻址实现。不做任何存储——序列化上收到 CoreSimos。</description>

  <dependencies>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-util</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId><artifactId>assertj-core</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-module-boundaries</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <!-- ★★ 2026-10-12 闭合（用户裁定「冻结各个模块的语义，确保下次改不越界」）：本仓的边界语义 = 「本模块不许**直接声明**某个依赖」；传递可见是 Maven 依赖图的事实、本模块控制不了 ⇒ 显式关掉传递检查（enforcer 3.6.3 `searchTransitive` 默认 true，字节码核实）。禁列全仓 simos 模块 − 自己 − 允许面，零例外。 -->
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                    <exclude>io.mosire:simos-social</exclude>
                    <exclude>io.mosire:simos-unit</exclude>
                    <exclude>io.mosire:simos-core</exclude>
                    <exclude>io.mosire:agentlib-mosire</exclude>
                    <!-- ★ Task 10 回填（AGENTS.md §〇 点名的欠账：本表停在 M0，此后新增模块从未回填）：
                         `simos-actor` 依赖 map（产权"到格"⇒ 它的键就是 HexCoord），地图侧永远不知道切片存在。
                         ★ `simos-actor-api` **不在此列**（契约层，与 `economy-api` 同待遇）。 -->
                    <exclude>io.mosire:simos-actor</exclude>
                    <!-- ★ C1（2026-10-02，D-019）：防反向依赖 calendar（依赖方向 util → map → calendar）。 -->
                    <exclude>io.mosire:simos-calendar</exclude>
                    <!-- ★★ 2026-10-12 模块语义冻结（docs/superpowers/specs/2026-10-12-module-boundaries-freeze.md §3）：
                         对称闭合 = 禁掉"本模块 + 允许面（util）之外"的全部 simos 模块。
                         ★ 上方 Task 10 那段"`simos-actor-api` 不在此列（契约层）"的口径**已被本次冻结取代**
                         （原文保留作留痕）：地图侧永远不知道切片存在，契约层同禁。
                         ★ `simos-ledger` 已退役、当前无同名模块：照冻结表列入，作历史留痕与未来防线。 -->
                    <exclude>io.mosire:simos-actor-api</exclude>
                    <exclude>io.mosire:simos-app</exclude>
                    <exclude>io.mosire:simos-army</exclude>
                    <exclude>io.mosire:simos-economy</exclude>
                    <exclude>io.mosire:simos-economy-api</exclude>
                    <!-- ★★ 2026-10-12 新增（设计书 docs/superpowers/specs/2026-10-12-ga-module-and-tool-descent.md
                         §4.1/§4.2）：`simos-ga-spi` 是**工具契约层**（只依赖 util）——地图侧永远不知道工具面存在
                         （"地图工具"住在 app/未来的 map 工具包，不反向依赖契约层）⇒ 按冻结文档 §4 I-F4 的口径列入。 -->
                    <exclude>io.mosire:simos-ga-spi</exclude>
                    <exclude>io.mosire:simos-gov</exclude>
                    <!-- ★★ 2026-10-12 B2a（设计书 §4.1 / §5 I-G2）：运行框架 simos-ga（工具运作 + 决策人运行）——
                         它永不依赖 app，其余模块也不得依赖它 ⇒ 列入禁列（组合根 simos-app 是唯一认识它的地方）。 -->
                    <exclude>io.mosire:simos-ga</exclude>
                    <exclude>io.mosire:simos-ledger</exclude>
                    <exclude>io.mosire:simos-sd</exclude>
                    <exclude>io.mosire:simos-social-api</exclude>
                  </excludes>
                  <message>simos-map 是地图与区域（地形/连通性/寻址），永不知道 SocialSimos / UnitSimos / ActorSimos 存在：只许依赖 simos-util。★ 禁列 = 全仓 simos 模块 − 自己 − util（含全部契约层、运行框架 ga 与已退役的 ledger，作历史留痕与未来防线），也不依赖 AgentLibMosire、不做任何存储。</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
