=== round=t11b-m12 module=simos-app target=simos-app/src/main/java/io/mosire/simos/app/access/DecisionCallerFactory.java tests=DecisionMakerScopeEndToEndTest,DecisionCallerFactoryTest ===
patch=import sys
p=sys.argv[1]; s=open(p,encoding="utf-8").read()
old="""    return decisionMakerOf(context, state)
        .map(DecisionMaker::affiliation)
        .filter(Affiliation.Nation.class::isInstance)
        .map(nation -> ((Affiliation.Nation) nation).nationId());"""
new="""    return decisionMakerOf(context, state)
        .map(
            maker ->
                maker.affiliation() instanceof Affiliation.Nation nation
                    ? nation.nationId()
                    : new NationId(maker.id().value()));"""
assert old in s
open(p,"w",encoding="utf-8").write(s.replace(old,new,1))
orig_md5=8b006aeadcf61519869adfb941635925
mutant_md5=a70179cdc50b3fb8d4a8fcb804d9537d
