=== round=t5t8-m4 module=simos-app target=simos-app/src/main/java/io/mosire/simos/app/access/DecisionCallerFactory.java tests=DecisionCallerFactoryTest,SimosToolsTest ===
patch=import sys
p=sys.argv[1]; s=open(p,encoding="utf-8").read()
old="          IssueDirectiveTool.NAME,\n          SubmitVerdictTool.NAME);"
new="          IssueDirectiveTool.NAME,\n          SubmitVerdictTool.NAME,\n          io.mosire.simos.app.tools.write.UnitRenameTool.NAME);"
assert old in s
open(p,"w",encoding="utf-8").write(s.replace(old,new,1))
