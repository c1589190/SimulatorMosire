=== round=m7 module=simos-app target=simos-app/src/main/java/io/mosire/simos/app/query/RedactingQueryService.java tests=RedactingQueryServiceTest,RedactionApiTest ===
patch=import sys
p=sys.argv[1]; s=open(p,encoding="utf-8").read()
old="        .map(c -> ToolSupport.hexVisible(c, mapId, map, coord))"
new="        .map(c -> c.resources().allows(io.mosire.agentlib.permission.Operation.READ, ToolSupport.resourceHex(mapId, coord.q(), coord.r())))"
assert old in s, "anchor not found"
open(p,"w",encoding="utf-8").write(s.replace(old,new))
orig_md5=bdeaf71b92741f471f00d2585e609390
mutant_md5=38468a537203e44f9f23b40f19528ab9
