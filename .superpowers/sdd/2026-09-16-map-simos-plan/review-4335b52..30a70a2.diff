+  for n in $CANON; do git -C "$REPO" show "$BASE:simos-map/src/test/java/io/mosire/simos/map/hex/${n%.java}Test.java" > "$TESTDIR/${n%.java}Test.java"; done
+  echo "[取出] $BASE 的 3 个 main + 3 个 test 已落盘；md5："
