    }
    return current;
  }

  
  @Override
  public void close() {
    if (closed) {
      return;
    }
    closed = true;
    HttpServer current = server;
    if (current != null) {
      current.stop(0);
      server = null;
    }
    executor.shutdownNow();
  }

