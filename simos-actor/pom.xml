<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.mosire</groupId>
    <artifactId>simos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>simos-actor</artifactId>
  <name>ActorSimos</name>
  <description>actor 切片的领域内核（S1 spec §三 L277）：Actor 身份本体 + 产权（AssetHolding）+ 商品库存（GoodsAccount）+ 状态树/落盘切片/变更集 + JSON 编解码（ActorCodec，namespace() = "actor"）。ActorData 的组件**恰是** `(meta, actors, holdings, accounts)` 四件；键类型各自自带"裸 toString() + 单参 parse"配对，codec 的四路键（ActorRef / AssetHoldingKey / GoodsAccountKey / 嵌套的 CommodityId）就靠这条配对过线。</description>

  <!-- ★ 依赖面 = actor-api（ActorRef / AssetClassKey——共用契约层）+ util（Snapshot / ChangeSet / FieldDelta / StateRef / SimosTimestamp）
       + **map（HexCoord——Task 5 起）**。
       ★ **为什么 Task 5 起真的要 map**：AssetHoldingKey 的 location 就是 HexCoord（产权是"到格"的）。
         这与 Task 1 裁定 R-e（"actor-api 不声明用不到的 simos-map"）不冲突——R-e 说的是**那时候不需要**的
         api 模块；切片此刻真 import 了 HexCoord ⇒ 声明它（口径同 R-h：不声明零 import 的依赖，也**不缺席**真 import 的依赖）。
       ★ **Task 6 起真的要 economy-api**：GoodsAccount.balances 的键是 CommodityId ⇒ 声明它。
         ★ **它不在本模块的 ban 列**：economy-api 是**共用契约层**（稳定 ID），economy 才是同层切片。
         ★ 口径同 R-h：不声明零 import 的依赖，也**不缺席**真 import 的依赖。
       ★ **Task 7 起真的要 jackson-databind**：ActorCodec 真 import 了 ObjectMapper / SimpleModule /
         KeyDeserializer（Task 4~6 那句"不声明 jackson"说的是**当时**：状态类型是 record + Map，零 Jackson import）。
         ★ 口径同 R-h：不声明零 import 的依赖，也**不缺席**真 import 的依赖。版本由父 POM 已 import 的 jackson-bom 提供。
       ★ 领域类型仍**零 Jackson 注解**：mapper 的装配（含四路键反序列化器）全在 ActorCodec 一个文件里，
         record / enum 走 Jackson 的默认绑定。
       ★ **不声明 spotbugs-annotations**：本任务的类型没有一处需要 @SuppressFBWarnings
         （只读包装一律写在赋值处，EI_EXPOSE_REP 不报），故不声明一个用不到的类型依赖；
         真需要时再加（在 simos-actor-api / simos-economy 里那条是**预防性**的，本模块不照抄预防性声明）。 -->
  <dependencies>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-actor-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-util</artifactId>
    </dependency>
    <!-- ★ Task 5 起：AssetHoldingKey.location 就是 HexCoord（产权"到格"）。-->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-map</artifactId>
    </dependency>
    <!-- ★ Task 6 起：GoodsAccount.balances 的键就是 CommodityId（库存"按商品"）。
         ★ simos-economy-api 是**契约层**（稳定 ID），不是切片 ⇒ 它**不在**本模块的 ban 列表里
         （见下面 enforcer 的注释）；本切片只吃它的类型，不碰 economy 的结算控制流。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-economy-api</artifactId>
    </dependency>
    <!-- ★ Task 7 起：ActorCodec 真的 import Jackson（ObjectMapper / SimpleModule / KeyDeserializer /
         JsonIgnore）。★ 版本由父 POM 已 import 的 jackson-bom 提供，不在此处写版本。 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId><artifactId>assertj-core</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-module-boundaries</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <!-- ★★ S1 阶段 2 裁定 R2 点名的两条：actor 切片**只允许类型依赖**
                         （可以 import CommodityId 这类契约类型），**不允许**运行时领域控制流反向流入
                         （不许调用 economy 的结算 / ledger 的 repository）。 -->
                    <exclude>io.mosire:simos-economy</exclude>
                    <exclude>io.mosire:simos-ledger</exclude>
                    <!-- 与 economy 的 enforcer 同款：切片之间互不依赖，且不许认识编排层。
                         ★ simos-economy-api **不在**禁列 —— 它是契约层，Task 6 要用它的 CommodityId。 -->
                    <exclude>io.mosire:simos-social</exclude>
                    <exclude>io.mosire:simos-unit</exclude>
                    <exclude>io.mosire:simos-sd</exclude>
                    <exclude>io.mosire:simos-core</exclude>
                    <exclude>io.mosire:simos-app</exclude>
                    <exclude>io.mosire:agentlib-mosire</exclude>
                  </excludes>
                  <message>只允许类型依赖，不允许运行时领域控制流反向流入（S1 阶段 2 裁定）：actor 切片只依赖 actor-api / util / map / economy-api，不依赖 economy、ledger（同层切片）与 social/unit/sd/core/app/agentlib。</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
