<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.mosire</groupId>
    <artifactId>simos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>simos-economy-api</artifactId>
  <name>EconomyApiSimos</name>
  <description>经济切片共用契约：稳定 ID（Asset/Production/Account/Market/Government/Commodity）与只读输入输出契约。无 Snapshot、无存储、无经济公式。★ ActorRef / ActorKind 等**主体契约不在这里**——它们住在更底层的 simos-actor-api；★ HouseholdId / PeopleLotId 自 2026-10-09 S1 起住在 simos-social-api，本模块只引用、不拥有。</description>

  <!-- ★ POLITICAL_ECONOMY_DESIGN §2/§10：六个经济切片（property/production/ledger/market/government 与
       social）共用这一层，各切片只依赖 api/util/map，彼此不作源码依赖。
       api 自己**不依赖任何 simos 领域模块**（只 actor-api + util + map + social-api 契约），故它必须排在领域的更上游
       （S1 阶段 2 起 actor-api 比它还底层；2026-10-09 S1 起 social-api 是更上游的稳定人口/家户契约）。 -->
  <dependencies>
    <!-- ★ S1 阶段 2（裁定 R7 的 A 段）：ActorRef / ActorKind 上移到 actor-api，而 LaborAllocation.actor
         仍持有 ActorRef ⇒ **不再拥有定义 ≠ 不再引用**，本条是编译期必需。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-actor-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-util</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-map</artifactId>
    </dependency>
    <!-- ★ 阶段 S1（2026-10-09 家户/人口架构 §3.2）：HouseholdId / PeopleLotId 迁入 simos-social-api，
         本模块只引用、不再拥有定义；显式声明（不靠传递依赖——"依赖传递不是契约"）。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-social-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId><artifactId>assertj-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.spotbugs</groupId><artifactId>spotbugs-annotations</artifactId>
      <version>4.10.4</version><scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-module-boundaries</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <!-- ★★ 2026-10-12 闭合（用户裁定「冻结各个模块的语义，确保下次改不越界」）：本仓的边界语义 = 「本模块不许**直接声明**某个依赖」；传递可见是 Maven 依赖图的事实、本模块控制不了 ⇒ 显式关掉传递检查（enforcer 3.6.3 `searchTransitive` 默认 true，字节码核实）。禁列全仓 simos 模块 − 自己 − 允许面，零例外。 -->
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                    <exclude>io.mosire:simos-social</exclude>
                    <exclude>io.mosire:simos-unit</exclude>
                    <exclude>io.mosire:simos-core</exclude>
                    <exclude>io.mosire:simos-app</exclude>
                    <!-- ★★ 2026-10-12 模块语义冻结（文档 §3）：对称闭合
                         = 禁掉"本模块 + 允许面（actor-api/util/map/social-api）之外"的全部 simos 模块。
                         ★ `simos-ledger` 已退役、当前无同名模块：照冻结表列入，作历史留痕与未来防线。
                         ★★ 同一冻结的 §4 I-F4 比 §3 的补进列更严：`simos-actor` 不在允许面里 ⇒ 按 I-F4 一并列入
                         （本模块只依赖 actor-api 契约，实测 actor 不在传递闭包上）。 -->
                    <exclude>io.mosire:simos-actor</exclude>
                    <exclude>io.mosire:simos-army</exclude>
                    <exclude>io.mosire:simos-calendar</exclude>
                    <exclude>io.mosire:simos-economy</exclude>
                    <exclude>io.mosire:simos-gov</exclude>
                    <!-- ★★ 2026-10-12 B2a（设计书 §4.1 / §5 I-G2）：运行框架 simos-ga（工具运作 + 决策人运行）——
                         它永不依赖 app，其余模块也不得依赖它 ⇒ 列入禁列（组合根 simos-app 是唯一认识它的地方）。 -->
                    <exclude>io.mosire:simos-ga</exclude>
                    <!-- ★★ 2026-10-12 B3 收尾：`simos-ga-spi`（工具契约层）补入禁列 —— 本模块不声明它（只可能经传递可见），而 `searchTransitive=false` 下禁列只拦直接声明 ⇒ 加它不会与传递链冲突。依据 = 台账 §7.4 的"谁声明谁除外"口径。 -->
                    <exclude>io.mosire:simos-ga-spi</exclude>
                    <exclude>io.mosire:simos-ledger</exclude>
                    <exclude>io.mosire:agentlib-mosire</exclude>
                    <!-- ★★ 2026-10-15 D-031 Z5（根 pom 16 → 18）：新增两模块均不在本模块允许面，
                         且 **本模块不得反向引用 production 新类型**（否则
                         production → economy-api → production 成环，spec §4）。 -->
                    <exclude>io.mosire:simos-culture</exclude>
                    <exclude>io.mosire:simos-production</exclude>
                  </excludes>
                  <message>simos-economy-api 是经济切片共用的稳定契约（各类稳定 ID / CommodityId / 市场 / 货币 / 关系 / 转移形状；无 Snapshot、无存储、无公式）：只许依赖 actor-api/util/map/social-api（★ 三者都是更底层的另一份契约，不是领域模块）；禁列 = 全仓 simos 模块 − 自己 − 允许面（含兄弟切片 economy/actor/gov/army、calendar、运行框架 ga 与已退役的 ledger）。 ★ 2026-10-15 D-031 Z5：新增 `simos-production` 与 `simos-culture`（根 pom 16 → 18）均不在本模块允许面，两条 exclude 同批补入（★ production 由本模块**上游依赖**，反向引用 = 环，spec §4 明禁）。</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
