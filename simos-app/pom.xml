<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.mosire</groupId>
    <artifactId>simos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>simos-app</artifactId>
  <name>SimosApp</name>
  <description>组合根：装配 CoreSimos 与领域模块（Shell / ShellConfig / ShellMain）。GUI/MCP/审批在 T6/T7/T8 接入。</description>

  <!-- ★ T2：前端单元测试门禁的 Node 可执行文件。可用 -Dnode.executable=<path> 覆盖；
       指到不存在的程序 ⇒ 构建必须红（fail-closed，见 spec §五）。 -->
  <properties>
    <node.executable>node</node.executable>
  </properties>

  <!-- ★ 依赖表照 spec §2.1。本模块**不设** maven-enforcer-plugin 的 bannedDependencies：
       它是组合根（ADR-1 §九 记的那笔账），天然认识全部领域模块与 AgentLib/MCP。
       父 POM 的 enforce-java-and-maven（Java 21 / Maven 3.8+）照常继承。 -->
  <dependencies>
    <!-- 唯一写入口：CoreSimos 门面 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-core</artifactId>
    </dependency>
    <!-- ★ R1 / spec §八.3：本模块**用了** util（56 个 main 文件）与 economy-api（2 个）却只靠**传递依赖**
         拿到它们——本仓早已把同款情形定性为缺陷并修过（`simos-core/pom.xml`："**依赖传递不是契约**"）。
         此处补上显式声明。版本由父 POM 的 dependencyManagement 提供。
         ★ S1 阶段 2：actor-api（ActorKind 用于 EconomySeeder、AssetKind 用于 ApiViews）同属此类 ——
         原先经 economy-api 传递拿到，一并显式声明。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-util</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-actor-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-economy-api</artifactId>
    </dependency>
    <!-- 领域类型、codec、handler、participant（装配用） -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-map</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-social</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-unit</artifactId>
    </dependency>
    <!-- ★ SDSimos（A1）：组合根装配 sd（codec/handler/participant/resolver，见 spec §一.4）。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-sd</artifactId>
    </dependency>
    <!-- ★ 聚合式经济（R1/R2a）：codec/resolver/命令 handler 与读口视图（§十"验收目标 A"）。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-economy</artifactId>
    </dependency>
    <!-- ★ S1 阶段 2：actor 切片（R2a 的经济同款装配面 —— codec/resolver/命令 handler）。
         ★★ 这里**显式**声明，不靠 simos-economy 的传递依赖：本 pom 上方那条 R1 注释已把"靠传递依赖拿到
         自己 main 里直接 new 的类型"定性为**缺陷**（simos-core 的原话："依赖传递不是契约"）——
         actor 的 ActorCodec/ActorResolver/ActorSeedHandler 全部在本模块 main 里直接 new ⇒ 同属此类。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-actor</artifactId>
    </dependency>
    <!-- ★ 阶段 10a（2026-09-30 GOV/Army 计划 §2.2）：行政切片 —— GovCodec 装进 Shell/RichWorld 的
         codec 列表（本阶段无 gov participant/handler）。★ 与上面 actor 同一条纪律：显式声明，不靠传递依赖。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-gov</artifactId>
    </dependency>
    <!-- ★ 阶段 12（2026-10-01 用户裁定 6/8）：军队切片——ArmyScope 改调 simos-army 的 ArmyVision（“辖区 = 视野”
         的唯一算法点）；NationSummary 也落 app 侧。★ 同一条纪律：显式声明，不靠传递依赖。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-army</artifactId>
    </dependency>
    <!-- 工具 / 权限 / 审批 / MCP（T5~T7 消费；依赖先按 spec 声明）。
         SNAPSHOT——跨机重建见 CLAUDE.md「换设备后的自检清单」第 2 条。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>agentlib-mosire</artifactId>
    </dependency>
    <!-- MCP SDK（spec §2.1：**禁**聚合 mcp，它带 Jackson 3）。版本由父 POM import 的 mcp-bom 提供。 -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId><artifactId>mcp-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId><artifactId>mcp-json-jackson2</artifactId>
    </dependency>
    <!-- 工具 payload / GUI JSON -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- ★ 可执行体的日志实现（M4 Task 3 裁定"实现归 app 层"）：main scope。
         版本由父 POM dependencyManagement 提供。 -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId><artifactId>log4j-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId><artifactId>log4j-slf4j2-impl</artifactId>
    </dependency>

    <!-- ★ M5 T1 实测补记（spec §2.1 之外的一件，provided、不影响产物）：
         `Shell.coreSimos()` 按 spec §3.2 必须交出 CoreSimos 引用，SpotBugs 判 EI_EXPOSE_REP。
         有意豁免需要 @SuppressFBWarnings，其注解住在 spotbugs-annotations 里。
         AgentLibMosire/BrainMosire 同法（该仓 pom 里同一条 provided 依赖）——此处照其先例。
         版本与 spotbugs 插件同代（4.10.4，~/.m2 已存在），不写进父 POM（本任务只许改父 POM 的模块行）。 -->
    <dependency>
      <groupId>com.github.spotbugs</groupId><artifactId>spotbugs-annotations</artifactId>
      <version>4.10.4</version><scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId><artifactId>assertj-core</artifactId>
    </dependency>
  </dependencies>

  <!-- ★ T2 前端单元测试门禁（spec §五）：把 webui 纯函数测试接进 test 阶段。
       用 exec-maven-plugin 直接跑 node（零 npm 依赖、不联网）；Node 不可用 ⇒ 插件报错、构建红
       （fail-closed，不设 skip/if 守卫）。驱动脚本自己解析 node 的测试汇总并卡断言数下界，
       因为 node 的测试运行器在没有匹配文件时会以 rc=0 静默通过。 -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <id>frontend-unit-tests</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${node.executable}</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>${project.basedir}/src/test/js/run-gate.cjs</argument>
              </arguments>
            </configuration>
          </execution>
          <!-- ★ 2026-09-21：shaded jar 内容不变量守卫（verify 阶段，跑在 package 之后）。
                由来：`5817` 关闭抛 `NoClassDefFoundError: reactor/core/publisher/LambdaMonoSubscriber`，
                实测真因是「运行中的 JVM 读到被就地重写的 jar」（见 tools/shaded-close-check.sh +
                docs/shade-evidence/），**不是** shaded jar 缺 reactor。但"运行期用到的类必须在内"
                仍是一条该被构建期钉死的不变量：`mcp-core` 哪天把 reactor 改成 optional/provided，
                编译与单测都不会红、只会在运行期炸。脚本 fail-closed：缺任一必需类或 Main-Class 不符即红。 -->
          <execution>
            <id>shaded-jar-guard</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>bash</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>${project.basedir}/src/verify/shaded-jar-guard.sh</argument>
                <argument>${project.build.directory}/${project.build.finalName}-shaded.jar</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- ★ M10 可分发产物（CLAUDE.md 里"shade 归开口项"的兑现）：产单件可跑物
             target/simos-app-${project.version}-shaded.jar（Main-Class = ShellMain + 全部依赖内联）。
             启动：java -jar simos-app-0.1.0-SNAPSHOT-shaded.jar 后接 store 目录与开关（见 ShellMain 用法）。
             仍保留瘦 jar（本插件用 classifier=shaded，不改主构件）。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>shade-executable</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>shaded</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.mosire.simos.app.ShellMain</mainClass>
                </transformer>
                <!-- MCP SDK / Jackson / SLF4J 的 META-INF/services 必须合并，否则 SPI 在 fat jar 里断链 -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
