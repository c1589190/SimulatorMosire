<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.mosire</groupId>
    <artifactId>simos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>simos-core</artifactId>
  <name>CoreSimos</name>
  <description>内核：时间线 DAG、两阶段时间推进、Command Bus、存储、可观测性。只依赖共享层，不依赖任何领域模块（ADR-1）。</description>

  <dependencies>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-util</artifactId>
    </dependency>
    <!-- CoreSimos 是唯一允许依赖 AgentLibMosire 的模块（spec §3.1 / G9）。
         版本由父 POM dependencyManagement 提供；类可用性由
         AgentLibAvailabilityTest 钉住，防止 ~/.m2 退回陈旧构建。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>agentlib-mosire</artifactId>
    </dependency>

    <!-- ★ M4 Task 5 裁定：SqliteStore 的驱动。main scope（Core 的存储层是产物的一部分）。
         版本 3.53.4.0 由父 POM dependencyManagement 提供。 -->
    <dependency>
      <groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId>
    </dependency>

    <!-- ★ M4 Task 17 关账补记（spec §二 / 〇.3 第 8 条）：Core main 源码**直接** import
         com.fasterxml.jackson.databind.*（CoreConfig/CoreSimos/CommandBus 等），此前只靠
         simos-util 的**传递依赖**在 classpath 上——「依赖传递不是契约」，此处补上显式声明。
         版本由父 POM 的 jackson-bom / dependencyManagement 提供，无需写版本。 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- ★ M4 Task 3 Step 6 裁定：日志**实现**只进 test scope。
         Core 是库，后端选择权归 app 层（M5）——main scope 加实现会让下游被迫接受一个后端。
         没有它，M4 跑起来只有一条 "SLF4J: No SLF4J providers were found" 警告：那是噪音，不是日志。 -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId><artifactId>log4j-core</artifactId><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId><artifactId>log4j-slf4j2-impl</artifactId><scope>test</scope>
    </dependency>

    <!-- ★ 领域模块一律 test scope（ADR-1 §六）。main scope 只留共享层 ⇒
         Core 编译期看不见 Unit / GameMap / PopulationSeries，铁律 4 由结构保证：
         想重新实现领域逻辑也无从下手。具体模块的装配归 app 层（M5 的 GUI / MCP）。
         test scope 保留是为了让 M4 的判据（时间线分岔 / correlationId 全链 /
         真实并发 CONFLICT）能端到端验——这不违反分层：test classpath 不是产物。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-map</artifactId><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-social</artifactId><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-unit</artifactId><scope>test</scope>
    </dependency>

    <!-- MCP SDK 到 M5 真正需要时再加（sqlite-jdbc 已在 main、日志实现已在 test，见上）。 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId><artifactId>assertj-core</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- ★ 本项目唯一"被限制的集成点"：其余四个模块禁 core，core 禁领域模块（ADR-1 §六）。
           写法是官方推荐的「宽 exclude + 窄 include」：先把三个领域模块在任何 scope 下禁掉，
           再只为 test scope 开一条口子。
           ⇒ provided / runtime 这些"编译期可见或可绕过"的 scope 一并被盖住
             （只 ban compile 会留下 provided 这条绕过路径）。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-core-boundaries</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>io.mosire:simos-map</exclude>
                    <exclude>io.mosire:simos-social</exclude>
                    <exclude>io.mosire:simos-unit</exclude>
                    <!-- ★ SDSimos（A1 / R2）：Core 编译期看不见 sd。
                         v1 不为 sd 开 test-scope 的 include（sd 的端到端测试在 app 层，spec §一.3 第 3 条）。 -->
                    <exclude>io.mosire:simos-sd</exclude>
                    <!-- ★ R1 / spec §八.3：Core 的 ban 列表同样停在 M0，此后新增的三个经济面模块
                         （economy / economy-api / ledger）**从未回填** ⇒ 当时 `core → economy*` 不会被拦。
                         main scope 一律禁（与 sd 同款）；`economy-api` 的 test-scope 口子见下面 includes 那段。 -->
                    <exclude>io.mosire:simos-economy</exclude>
                    <exclude>io.mosire:simos-economy-api</exclude>
                    <exclude>io.mosire:simos-ledger</exclude>
                  </excludes>
                  <includes>
                    <include>io.mosire:simos-map:*:*:test</include>
                    <include>io.mosire:simos-social:*:*:test</include>
                    <include>io.mosire:simos-unit:*:*:test</include>
                    <!-- ★★ R1 **实测暴露**的一条（加完上面三条 ban 之后立刻红，不是推理）：
                         `core(test) → social → economy-api`。R1 的 T2 让 `simos-social` 依赖 `simos-economy-api`
                         （复用 `PeopleLotId` 作人口批次的身份**是文档明文允许的**：`economy-api/package-info.java:9-11`），
                         而 Core 的 test classpath **本来就**依赖 social（M4 判据要端到端跑），
                         于是 economy-api 由**传递依赖**进到 test classpath —— 这一步不可避免，除非 Core 的测试放弃 social。
                         ⇒ 按本文件既有的「宽 exclude + 窄 include」写法开**同一口径的 test-scope 口子**（与 map/social/unit 三条同款）：
                         **main scope 仍一条都不许有**（那才是 ADR-1 §六要守的东西；test classpath 不是产物）。
                         ★ 这条不是"偷偷放行"：它由 enforcer 自己逼出来，且只放开 test。 -->
                    <include>io.mosire:simos-economy-api:*:*:test</include>
                  </includes>
                  <message>CoreSimos 的 main scope 不得依赖领域模块（ADR-1 §六）：铁律 4「Core 不重新实现领域逻辑」由结构保证。领域模块只允许在 test scope 出现；三个经济面模块（economy/economy-api/ledger）任何 scope 都不允许（R1 / spec §八.3）</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
