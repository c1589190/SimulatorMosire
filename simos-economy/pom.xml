<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.mosire</groupId>
    <artifactId>simos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>simos-economy</artifactId>
  <name>EconomySimos</name>
  <description>经济切片骨架（新经济设计 §3 状态形状，无公式）：产业表（制度/周期/进度/日投入/产出/阶层槽位/分配函数）、阶层行（人口/有效劳动/劳动投入率/生产资料/库存/货币/债务引用/需求）、债务表、周期流水，外加激活元信息。生产/分配/税/市场的公式属于 R2+。</description>

  <!-- ★ 新经济设计 §2：economy 切片独占产业表 / 阶层行 / 债务表 / 周期流水 / 分配函数。
       依赖面 = actor-api（AssetKind——S1 阶段 2 上移的产权基础词表）+ util（FieldDelta/Snapshot/地址与解析机制）
       + economy-api（IndustryId/ClassSlotId/RegimeId/DebtId/CommodityId——共用稳定 ID）+ Jackson。
       ★ 方案 A（2026-10-09）：另允许直接依赖 social（人员/家户唯一域）与低层契约 social-api
         （HouseholdId / PeopleLotId）。
       ★★ H4 起**也依赖 map**：市场表按**格**索引（EconomyData.markets 的键 = HexCoord，裁定 M1-A），
       而"依赖传递不是契约"（AGENTS.md §〇）⇒ 显式声明，不再靠 economy-api 的传递依赖拿 HexCoord。
       ★ 这不是新开的口子：economy-api 本来就依赖 map（LotChange.hex），本切片此前已在用它的传递类型。 -->
  <dependencies>
    <!-- ★ S1 阶段 2（裁定 R7 的 A 段）：AssetKind 上移后原先靠 economy-api 传递拿到，现按本模块的
         "依赖传递不是契约"口径**显式**声明。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-actor-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-util</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-economy-api</artifactId>
    </dependency>
    <!-- ★★ H4：市场表键 = HexCoord（见上面的依赖面注释）。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-map</artifactId>
    </dependency>
    <!-- ★ 阶段 S1（2026-10-09 家户/人口架构 §3.2）：HouseholdId / PeopleLotId 迁入 simos-social-api 后，
         本模块 main 直接 import 这两个稳定 ID ⇒ 显式声明（不靠 economy-api / simos-social 传递——
         "依赖传递不是契约"）。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-social-api</artifactId>
    </dependency>
    <!-- ★ 方案 A（2026-10-09 用户裁定）：Social 是人员/家户的唯一域，economy 允许**大方直连**
         `simos-social` 实现（家户人口份额 / 工单受理口等状态与服务），不再受"只许走 social-api"的旧边界。
         版本由父 POM 的 dependencyManagement 提供。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-social</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- ★★ 2026-10-12 B3 第三域（设计书 §4.3 / I-G5）：经济工具下放到 economy.tools.{read,write} 后，
         本模块需要工具契约层 ga-spi（ToolWritePort / ToolReadPort / ToolSchema / ToolResources / ToolResults）。
         ★ 禁列里本来就没有它（只有 util/map/calendar/social-api/actor-api 五模块按冻结文档 §4 I-F4 列了它）
         ⇒ 只加依赖，不动禁列、不加 <includes>。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-ga-spi</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId><artifactId>assertj-core</artifactId>
    </dependency>

    <!-- ★ 与 simos-ledger/simos-social/simos-app 的同一条 provided 依赖同款（照其先例；版本与 spotbugs 插件同代）：
         门禁若在本地类型上报 EI_EXPOSE_REP 类误报，@SuppressFBWarnings 的注解住在这里。 -->
    <dependency>
      <groupId>com.github.spotbugs</groupId><artifactId>spotbugs-annotations</artifactId>
      <version>4.10.4</version><scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-module-boundaries</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <!-- ★★ 2026-10-12 闭合（用户裁定「冻结各个模块的语义，确保下次改不越界」）：本仓的边界语义 = 「本模块不许**直接声明**某个依赖」；传递可见是 Maven 依赖图的事实、本模块控制不了 ⇒ 显式关掉传递检查（enforcer 3.6.3 `searchTransitive` 默认 true，字节码核实）。禁列全仓 simos 模块 − 自己 − 允许面，零例外。 -->
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                    <!-- ★ 2026-10-09 方案 A（用户裁定）：原 `exclude simos-social` 已删——
                         Social 是人员/家户的唯一域，economy 允许直接依赖其实现（与 social 单向，不成环）。
                         契约层 economy-api / social-api / actor-api 与纯计算 calendar 都不在禁列。 -->
                    <exclude>io.mosire:simos-unit</exclude>
                    <exclude>io.mosire:simos-sd</exclude>
                    <exclude>io.mosire:simos-core</exclude>
                    <exclude>io.mosire:simos-app</exclude>
                    <exclude>io.mosire:agentlib-mosire</exclude>
                    <!-- ★★ 2026-10-12 模块语义冻结（文档 §3）：对称闭合补禁 army / gov
                         （`ledger` 原已在列；已退役、当前无同名模块，作历史留痕与未来防线）。
                         允许面 = actor-api/util/economy-api/map/social-api/social。
                         ★★ **传递依赖例外（2026-10-12 实测）**：冻结表 §3 也把 `simos-calendar` 列进本模块禁列，
                         但它**加不进来**——enforcer 3.6.3 `searchTransitive` 默认 true ⇒ 禁列查传递依赖，实测链：
                             simos-economy → simos-social → simos-calendar
                         （方案 A 起 economy 直连 social，social 显式声明 calendar）⇒ 加进去 `validate` 当场红。
                         ★ I-F2 禁止加 `<includes>` 绕过 ⇒ 此处不列 calendar；归属应由冻结表重算（另裁）。
                         ★★ 同一冻结的 §4 I-F4 比 §3 的补进列更严：`simos-actor` 不在允许面里 ⇒ 按 I-F4 一并列入
                         （economy 只依赖 actor-api 契约，实测 actor 不在传递闭包上）。 -->
                    <exclude>io.mosire:simos-actor</exclude>
                    <exclude>io.mosire:simos-army</exclude>
                    <exclude>io.mosire:simos-gov</exclude>
                    <!-- ★★ 2026-10-12 B2a（设计书 §4.1 / §5 I-G2）：运行框架 simos-ga（工具运作 + 决策人运行）——
                         它永不依赖 app，其余模块也不得依赖它 ⇒ 列入禁列（组合根 simos-app 是唯一认识它的地方）。 -->
                    <exclude>io.mosire:simos-ga</exclude>
                    <exclude>io.mosire:simos-ledger</exclude>
                    <exclude>io.mosire:simos-calendar</exclude>
                  </excludes>
                  <message>simos-economy 是聚合式经济切片（产业/阶层行/债务/流水/市场/货币/政府政策），**机制与规则的归属地**：只许依赖 actor-api/util/economy-api/map/social-api/social + 工具契约层 ga-spi（★ 方案 A 2026-10-09：允许直连 social —— 人员/家户唯一域；★★ 2026-10-12 B3 第三域：工具下放后加 ga-spi）；禁列 = 全仓 simos 模块 − 自己 − 允许面（含 unit/sd/core/app、army/gov、运行框架 ga 与同层 actor、已退役的 ledger）。★ 例外：calendar 由 social 传递带出，按 I-F1 不入禁列（见上方注）。</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
