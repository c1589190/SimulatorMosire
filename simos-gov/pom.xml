<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.mosire</groupId>
    <artifactId>simos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>simos-gov</artifactId>
  <name>GovSimos</name>
  <description>行政切片（阶段 10a 骨架）：每 tick 行政读数（GovOfficeState）的状态树 / 落盘切片 / 变更集 / JSON 编解码（GovCodec，namespace() = "gov"）与 GovRules 常量。编制字段本身在 unit 片（UnitModule），本模块只拥有"每 tick 读数"。</description>

  <!-- ★ 依赖面（计划 §2.2 的依赖表）：
       util（Snapshot / ChangeSet / FieldDelta / StateRef / SimosTimestamp）、
       map（阶段 11 的 GovDemand 逐格算需求用 HexCoord；本阶段暂无 import）、
       unit（UnitId 与 GovFormation 的读取）、
       social（阶段 11 的 GovDemand 读人口/城市；本阶段暂无 import）、
       economy-api（CommodityId / CurrencyId —— GovOfficeState 六张读数表的键）。
       ★ 本阶段 10a 真正的 import 只有 util / unit / economy-api；map 与 social 是计划里阶段 11 结算的输入面，
         按任务书先声明（不是"顺手加的"；见类注里对阶段 11 的指向）。
       ★ actor-api 只在真用 ActorRef 时才该声明：本阶段没有 ActorRef，故不加（任务书口径）。
       ★ 不得依赖 core / app（铁律 3：领域模块不认识组合与调度）——由下面的 enforcer 构建期强制。 -->
  <dependencies>
    <!-- ★ 2026-10-12 B3 第六域：门禁若在本地类型上报 EI_EXPOSE_REP / BC_UNCONFIRMED_CAST 类误报，
         @SuppressFBWarnings 注解住在这里（version 与 spotbugs 插件同代；照 unit/social-api/economy-api 的先例）。 -->
    <dependency>
      <groupId>com.github.spotbugs</groupId><artifactId>spotbugs-annotations</artifactId>
      <version>4.10.4</version><scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-util</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-map</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-unit</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-social</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-economy-api</artifactId>
    </dependency>
    <!-- ★★ 2026-10-12 B3 第六域（gov 工具下放）：工具契约层 ga-spi —— SimosTool 的标签面（GmOnlyRead）、窄写口
         ToolWritePort、窄读口 ToolReadPort 与 ToolResources/ToolSchema/ToolResults 三件纯助手。
         ★ 允许面因此扩为 util/map/unit/social/economy-api/ga-spi（设计书 §4.1：域模块依赖 ga-spi 而不是 ga —— 反过来会成环）。
         ★ agentlib-mosire 仍在禁列：工具所需 agentlib 类型（AgentTool/ToolContext/ResourceManifest…）走 ga-spi 传递引入
           （`searchTransitive=false` 只拦直接声明，与 map/army/economy/social/unit 五批的 D3 同款）。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-ga-spi</artifactId>
    </dependency>
    <!-- GovCodec 真的 import Jackson（ObjectMapper / SimpleModule / KeyDeserializer）。版本由父 POM 已
         import 的 jackson-bom 提供。 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- 阶段 11 的日结算日志面（计划 §2.5 的"日志汇总"）；本阶段没有使用点，按任务书声明。 -->
    <dependency>
      <groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId><artifactId>assertj-core</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-module-boundaries</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <!-- ★★ 2026-10-12 闭合（用户裁定「冻结各个模块的语义，确保下次改不越界」）：本仓的边界语义 = 「本模块不许**直接声明**某个依赖」；传递可见是 Maven 依赖图的事实、本模块控制不了 ⇒ 显式关掉传递检查（enforcer 3.6.3 `searchTransitive` 默认 true，字节码核实）。禁列全仓 simos 模块 − 自己 − 允许面，零例外。 -->
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                    <!-- 铁律 3：行政切片不认识组合与调度。 -->
                    <exclude>io.mosire:simos-core</exclude>
                    <exclude>io.mosire:simos-app</exclude>
                    <exclude>io.mosire:agentlib-mosire</exclude>
                    <!-- 切片之间互不依赖（对称）：sd 是领域模块的下游；economy / actor 是兄弟切片。
                         ★ economy-api 与 actor-api **不在禁列**（契约层，任务书明文允许；本阶段只用了 economy-api 的 ID）。
                         ★ map / social / unit 是计划 §2.2 明确允许的上游，也不在禁列。 -->
                    <exclude>io.mosire:simos-economy</exclude>
                    <exclude>io.mosire:simos-actor</exclude>
                    <!-- ★★ 2026-10-12 模块语义冻结（文档 §3）：对称闭合
                         = 禁掉"本模块 + 允许面（util/map/unit/social/economy-api）之外"的全部 simos 模块。
                         ★ 上游那段"actor-api 不在禁列"的口径已被取代（契约层也不再例外），原文保留作留痕；
                         ★ `simos-ledger` 已退役、当前无同名模块：照冻结表列入；★ army 是兄弟切片实现。
                         ★★ **传递依赖例外（2026-10-12 实测）**：冻结表 §3 把 `simos-actor-api` 也列进本模块禁列，
                         但它**加不进来**（enforcer 3.6.3 `searchTransitive` 默认 true ⇒ 禁列查传递依赖）。
                         实测链（Maven 原文）：simos-gov → simos-economy-api → simos-actor-api
                         （gov 显式声明 economy-api，economy-api 显式声明 actor-api）
                         ★ I-F2 禁止加 `<includes>` 白名单绕过 ⇒ 此处不列 actor-api；归属由冻结表重算（另裁）。 -->
                    <exclude>io.mosire:simos-army</exclude>
                    <!-- ★★ 2026-10-12 B2a（设计书 §4.1 / §5 I-G2）：运行框架 simos-ga（工具运作 + 决策人运行）——
                         它永不依赖 app，其余模块也不得依赖它 ⇒ 列入禁列（组合根 simos-app 是唯一认识它的地方）。 -->
                    <exclude>io.mosire:simos-ga</exclude>
                    <exclude>io.mosire:simos-ledger</exclude>
                    <exclude>io.mosire:simos-actor-api</exclude>
                    <exclude>io.mosire:simos-calendar</exclude>
                    <exclude>io.mosire:simos-social-api</exclude>
                  </excludes>
                  <!-- ★★ 2026-10-12 B3 第六域：允许面扩为 util/map/unit/social/economy-api/**ga-spi**（工具契约层）。
                       ★ ga-spi **不入禁列**：它是域模块写工具的唯一契约面（设计书 §4.1），且它自己不依赖 core/域。
                       ★ 传依赖的契约层（social-api / calendar / actor-api）仍在禁列里：`searchTransitive=false` 只拦
                         **直接声明**，传递可见不受影响（这三条一直由 social / economy-api 传递带出）。 -->
                  <message>simos-gov 是政府：行政编制、国库预算、区划服务 + **外交**（Nation / 关系 / 事件；2026-10-12 用户裁定"外交是 gov 的事"）：只许依赖 util/map/unit/social/economy-api + 工具契约层 ga-spi（2026-10-12 B3 第六域下放后）；禁列 = 全仓 simos 模块 − 自己 − 允许面（含 core/app/agentlib、运行框架 ga、兄弟切片 economy/actor/army 与已退役的 ledger；`simos-sd` 已于 2026-10-12 整模块退役）。★ 留痕：social-api / calendar / actor-api 三条由 social 与 economy-api **传递**带出（旧口径"按 I-F1 不入禁列"已被 2026-10-12 冻结批取代 —— 它们在禁列里，但 searchTransitive=false 使传递可见不触禁）。</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
