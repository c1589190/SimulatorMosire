<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.mosire</groupId>
    <artifactId>simos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>simos-social</artifactId>
  <name>SocialSimos</name>
  <description>hex 社会属性（当前仅人口）：带时间戳的时态序列与分段增长率积分。不完善的测试模块。</description>

  <dependencies>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-util</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-map</artifactId>
    </dependency>
    <!-- ★ R1 / 设计稿 §八.1：人口批次的**身份**复用 economy-api 已有的 `PeopleLotId`（它注释自称"该批次的稳定身份"，
         本阶段从"spec v2 列出的死代码"复活）。★ 这是文档**明文允许**的方向，不是破例：
         `economy-api/package-info.java:9-11`「五个经济切片…**与 `simos-social` 可依赖本模块与 util/map**」，
         根 `pom.xml:25-26`、`economy-api/pom.xml:16-18` 同款；故 social 的 enforcer **不拦**它
         （反方向的 `simos-economy` 已在下面补禁）。版本由父 POM 的 dependencyManagement 提供。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-economy-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId><artifactId>assertj-core</artifactId>
    </dependency>

    <!-- ★ 2026-09-24 补（跑 clean verify 时发现本模块有 3 条 SpotBugs 判据）：
         `gen/ArmyPlan` 的 EI_EXPOSE_REP 与 `gen/ValueRange` 的两处 FE_FLOATING_POINT_EQUALITY
         都是**误报**（前者：两张表已逐层复制 + unmodifiableMap；后者：`min == max` 判的是"区间被 clamp 压成一点"这一语义），
         有意豁免需要 @SuppressFBWarnings，其注解住在 spotbugs-annotations 里。
         ★ 与 simos-app/pom.xml 的同一条 provided 依赖同款（照其先例；版本与 spotbugs 插件同代）。 -->
    <dependency>
      <groupId>com.github.spotbugs</groupId><artifactId>spotbugs-annotations</artifactId>
      <version>4.10.4</version><scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-module-boundaries</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>io.mosire:simos-unit</exclude>
                    <exclude>io.mosire:simos-core</exclude>
                    <exclude>io.mosire:agentlib-mosire</exclude>
                    <!-- ★ R1 / spec §八.3：本模块的 ban 列表停在 M0（2026-09-16，当时全仓只有 5 个模块），
                         此后新增的 `simos-economy` **从未回填** ⇒ 当时 `social → economy` 不会被拦
                         （那正是"边界可信"里的假话）。此处补禁。
                         ★ 注意：`simos-economy-api` **不在此列、也不许加进来**——文档三处明文允许 social 依赖它
                         （`economy-api/package-info.java:9-11`、根 `pom.xml`、`economy-api/pom.xml`），
                         R1 的 `PopulationGroup.id` 正是复用它的 `PeopleLotId`（spec §八.1）。 -->
                    <exclude>io.mosire:simos-economy</exclude>
                    <!-- ★ Task 10 回填（AGENTS.md §〇 点名的欠账：本表停在 M0，此后新增模块从未回填）：
                         actor 与 social 是**兄弟切片**：`ActorKind.PEOPLE_LOT` 只是不透明种类串，
                         人群批次的**身份**（`PeopleLotId`）走的是 economy-api 那条明文允许的路，不是 actor。
                         ★ `simos-actor-api` **不在此列**（契约层，与 `economy-api` 同待遇）。 -->
                    <exclude>io.mosire:simos-actor</exclude>
                  </excludes>
                  <message>SocialSimos 与 UnitSimos 互不依赖（spec §3.1 / G8）；也不得依赖 simos-economy（R1 / spec §八.3；economy-api 例外，文档明文允许）与 simos-actor（兄弟切片，Task 10 回填）</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
