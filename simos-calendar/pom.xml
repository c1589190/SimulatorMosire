<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.mosire</groupId>
    <artifactId>simos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>simos-calendar</artifactId>
  <name>CalendarSimos</name>
  <description>儒略历/节气/季节的纯计算模块；无状态、无存储、无 Codec/ChangeSet；依赖 util + map</description>

  <!-- ★ C1（2026-10-02）：依赖方向固定为 util → map → calendar（D-019 用户裁定）。
       util 供共享 YearFraction 值类型，map 供 HexCoord（季节分带读 .r()）；
       二者**显式声明**，不靠任何传递依赖。本模块无 Snapshot/Codec/ChangeSet/handler/存储，
       不 import Jackson、不碰文件系统。 -->
  <dependencies>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-map</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-util</artifactId>
    </dependency>

    <!-- 测试依赖形态照 simos-actor-api / simos-map：junit/assertj 的版本与 test scope
         由父 POM 的 dependencyManagement 提供；spotbugs-annotations 与 spotbugs 插件同代。 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId><artifactId>assertj-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.spotbugs</groupId><artifactId>spotbugs-annotations</artifactId>
      <version>4.10.4</version><scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-module-boundaries</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <!-- ★★ 2026-10-12 闭合（用户裁定「冻结各个模块的语义，确保下次改不越界」）：本仓的边界语义 = 「本模块不许**直接声明**某个依赖」；传递可见是 Maven 依赖图的事实、本模块控制不了 ⇒ 显式关掉传递检查（enforcer 3.6.3 `searchTransitive` 默认 true，字节码核实）。禁列全仓 simos 模块 − 自己 − 允许面，零例外。 -->
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                    <exclude>io.mosire:simos-social</exclude>
                    <exclude>io.mosire:simos-unit</exclude>
                    <exclude>io.mosire:simos-sd</exclude>
                    <exclude>io.mosire:simos-core</exclude>
                    <exclude>io.mosire:simos-app</exclude>
                    <exclude>io.mosire:simos-economy-api</exclude>
                    <exclude>io.mosire:simos-economy</exclude>
                    <exclude>io.mosire:simos-actor-api</exclude>
                    <exclude>io.mosire:simos-actor</exclude>
                    <exclude>io.mosire:simos-gov</exclude>
                    <exclude>io.mosire:simos-army</exclude>
                    <!-- ★★ 2026-10-12 新增（设计书 docs/superpowers/specs/2026-10-12-ga-module-and-tool-descent.md
                         §4.1/§4.2）：`simos-ga-spi` 是工具契约层，位于 map/calendar **之上**（依赖它的
                         `ga-spi → util`、域模块的工具实现 → ga-spi）⇒ 纯计算的 calendar 永远不认识工具面，
                         按冻结文档 §4 I-F4 的口径列入。 -->
                    <exclude>io.mosire:simos-ga-spi</exclude>
                    <!-- ★★ 2026-10-12 模块语义冻结（文档 §3）：`simos-ledger` 已退役、当前无同名模块，
                         照冻结表列入，作历史留痕与未来防线。
                         ★★ 同一冻结的 §4 I-F4（"禁掉自己 + 允许面之外的全部 simos 模块"）比 §3 的补进列更严：
                         `simos-social-api` 不在 §3 的补进列里，但 calendar 的允许面只有 util/map ⇒ 按 I-F4 一并列入
                         （本模块的传递闭包只有 map/util，实测不落在传递链上）。 -->
                    <exclude>io.mosire:simos-social-api</exclude>
                    <!-- ★★ 2026-10-12 B2a（设计书 §4.1 / §5 I-G2）：运行框架 simos-ga（工具运作 + 决策人运行）——
                         它永不依赖 app，其余模块也不得依赖它 ⇒ 列入禁列（组合根 simos-app 是唯一认识它的地方）。 -->
                    <exclude>io.mosire:simos-ga</exclude>
                    <exclude>io.mosire:simos-ledger</exclude>
                    <exclude>io.mosire:agentlib-mosire</exclude>
                  </excludes>
                  <message>simos-calendar 是纯计算历法（儒略历 + 24 节气/天文季界 + 分带季节，无状态、无存储、不碰 Jackson/文件系统）：只许依赖 util + map（util 供共享 YearFraction，map 供 HexCoord 判带）。★ 禁列 = 全仓 simos 模块 − 自己 − util/map（含全部契约层、运行框架 ga 与已退役的 ledger）。</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
