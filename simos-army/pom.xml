<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.mosire</groupId>
    <artifactId>simos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>simos-army</artifactId>
  <name>ArmySimos</name>
  <description>军队切片（阶段 12 最小版）：只做“军队辖区 = 视野”的纯派生视图（ArmyVision），不算任何战力。</description>

  <!-- ★ 依赖面（用户阶段 12 裁定 + 2026-10-09 方案 A）：util（SimosTimestamp）、map（HexCoord/HexGrid）、
       unit（Unit/UnitState/UnitId）、social（人员/家户唯一域——方案 A 允许业务模块大方直连）。
       ★ 仍不依赖 sd / gov / economy / actor / app / core（铁律 3：领域模块不认识组合与调度；
         兄弟切片**实现**互不依赖）。social 传递带出的 economy-api / actor-api / social-api / calendar
         都是更上游的契约层或纯计算层，不是禁止对象。
       ★ 依赖由下面的 enforcer 构建期强制。 -->
  <dependencies>
    <!-- ★ T2 收尾（2026-10-02，照 simos-app 先例）：CombatResolution 的“每阶段一次投骰必须可复现”
         与 SpotBugs 的 DMI_RANDOM_USED_ONLY_ONCE 冲突 ⇒ 精确豁免需要 @SuppressFBWarnings。
         provided、不进产物；版本与 spotbugs 插件同代（4.10.4）。 -->
    <dependency>
      <groupId>com.github.spotbugs</groupId><artifactId>spotbugs-annotations</artifactId>
      <version>4.10.4</version><scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-util</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-map</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-unit</artifactId>
    </dependency>
    <!-- ★ 方案 A（2026-10-09 用户裁定）：Social 是人员/家户的唯一域，army 允许直接依赖 simos-social 实现；
         它传递带出的 economy-api / actor-api / social-api / calendar 是更上游的契约层或纯计算层。
         版本由父 POM 的 dependencyManagement 提供。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-social</artifactId>
    </dependency>
    <!-- ★ 阶段 D1（2026-10-02）：Army 切片落地 —— ArmyCodec 真 import Jackson（ObjectMapper /
         SimpleModule / KeyDeserializer / JsonIgnore）。★ 版本由父 POM 的 dependencyManagement
         提供，不在此处写版本；★ 它**不在**下面的 ban 列（ban 列管的是 simos 模块与 agentlib，不是基础库）。
         ★ 口径同 actor：不声明零 import 的依赖，也不缺席真 import 的依赖。 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- ★ T2a（2026-10-02）：本模块此前零测试 ⇒ 未声明测试依赖；新测试目录要 junit/assertj，
         版本与 scope=test 均由父 POM 的 dependencyManagement 提供（照 sd/actor 的声明形式）。 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId><artifactId>assertj-core</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-module-boundaries</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <!-- ★★ 2026-10-12 闭合（用户裁定「冻结各个模块的语义，确保下次改不越界」）：本仓的边界语义 = 「本模块不许**直接声明**某个依赖」；传递可见是 Maven 依赖图的事实、本模块控制不了 ⇒ 显式关掉传递检查（enforcer 3.6.3 `searchTransitive` 默认 true，字节码核实）。禁列全仓 simos 模块 − 自己 − 允许面，零例外。 -->
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                    <!-- 组合/调度层（铁律 3/4）。 -->
                    <exclude>io.mosire:simos-core</exclude>
                    <exclude>io.mosire:simos-app</exclude>
                    <exclude>io.mosire:agentlib-mosire</exclude>
                    <!-- 阶段 12 + 方案 A（2026-10-09）：Army 不再是 sd 的下游，也不属于经济/行政切片**实现**。
                         ★ 兄弟切片实现仍禁（防环）：economy / actor；sd / gov 也禁。
                         ★ simos-social 是方案 A 允许直连的人员/家户唯一域；economy-api / actor-api /
                           social-api 虽由它传递带出，但都是更上游的契约层 ⇒ 全部不在禁列。 -->
                    <exclude>io.mosire:simos-sd</exclude>
                    <exclude>io.mosire:simos-gov</exclude>
                    <exclude>io.mosire:simos-economy</exclude>
                    <exclude>io.mosire:simos-actor</exclude>
                    <!-- ★★ 2026-10-12 模块语义冻结（文档 §3）：对称闭合
                         = 禁掉"本模块 + 允许面（util/map/unit/social）之外"的全部 simos 模块。
                         ★ 上方那段"economy-api / actor-api / social-api 全不在禁列"的口径已被取代
                         （原文保留作留痕）——它们是 social/unit 传递带出的，见下面的传递依赖例外注。
                         ★ `simos-ledger` 已退役、当前无同名模块：照冻结表列入，作历史留痕与未来防线。
                         ★★ **传递依赖例外（2026-10-12 实测，三条）**：冻结表 §3 把 `actor-api` /
                         `economy-api` / `social-api` 也列进本模块禁列，但它们**加不进来**
                         （enforcer 3.6.3 `searchTransitive` 默认 true ⇒ 禁列查传递依赖）。实测链（Maven 原文）：
                             simos-army → simos-unit → simos-social-api
                             simos-army → simos-social → simos-economy-api → simos-actor-api
                         ★ I-F2 禁止加 `<includes>` 白名单绕过 ⇒ 此处不列它们；归属由冻结表重算（另裁）。 -->
                    <!-- ★★ 2026-10-12 B2a（设计书 §4.1 / §5 I-G2）：运行框架 simos-ga（工具运作 + 决策人运行）——
                         它永不依赖 app，其余模块也不得依赖它 ⇒ 列入禁列（组合根 simos-app 是唯一认识它的地方）。 -->
                    <exclude>io.mosire:simos-ga</exclude>
                    <exclude>io.mosire:simos-ledger</exclude>
                    <exclude>io.mosire:simos-actor-api</exclude>
                    <exclude>io.mosire:simos-calendar</exclude>
                    <exclude>io.mosire:simos-economy-api</exclude>
                    <exclude>io.mosire:simos-social-api</exclude>
                  </excludes>
                  <message>simos-army 是交战记录与军方编排（一期：辖区 = 视野的纯派生视图，不落盘、不算战力）：只许依赖 util/map/unit/social；禁列 = 全仓 simos 模块 − 自己 − 允许面（含 core/app/agentlib、sd、运行框架 ga、兄弟切片 gov/economy/actor 与已退役的 ledger）。★ 例外：social-api / calendar / economy-api / actor-api 由 unit 与 social 传递带出，四条按 I-F1 不入禁列。</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
