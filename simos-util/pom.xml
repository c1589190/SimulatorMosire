<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.mosire</groupId>
    <artifactId>simos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>simos-util</artifactId>
  <name>UtilSimos</name>
  <description>零领域依赖地基：地址/身份/时间/版本原语、快照与变更集协议、Info 外挂属性、时态序列、Resolver SPI。不依赖 AgentLibMosire，不碰文件系统。</description>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- ★ M4 Task 3 裁定（2026-09-18）：Optional 在快照树里且在嵌套泛型位置
         （Unit.java:23/24/29 的 SegmentedSeries<Optional<…>>、SimosTimestamp.calendarLabel、
         TimeRange.to）。裸 jackson-databind 会把 Optional 写成 {"present":…} 并丢值。
         手写替代方案 = 又一份"手工对着状态类型维护的平行结构" = L1 事故形态（MapDiff 漂移）。
         ⇒ 用 Jackson 家族构件，不是领域模块，不违反铁律 3。
         版本由父 POM 已 import 的 jackson-bom 提供，无需新增版本属性。
         ★ 探针实测：无它则三个快照**全部**死在序列化期。 -->
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId><artifactId>jackson-datatype-jdk8</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId><artifactId>assertj-core</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-module-boundaries</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <!-- ★★ 2026-10-12 闭合（用户裁定「冻结各个模块的语义，确保下次改不越界」）：本仓的边界语义 = 「本模块不许**直接声明**某个依赖」；传递可见是 Maven 依赖图的事实、本模块控制不了 ⇒ 显式关掉传递检查（enforcer 3.6.3 `searchTransitive` 默认 true，字节码核实）。禁列全仓 simos 模块 − 自己 − 允许面，零例外。 -->
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                    <exclude>io.mosire:agentlib-mosire</exclude>
                    <exclude>io.mosire:simos-map</exclude>
                    <exclude>io.mosire:simos-social</exclude>
                    <exclude>io.mosire:simos-unit</exclude>
                    <exclude>io.mosire:simos-core</exclude>
                    <!-- ★ Task 10 回填（AGENTS.md §〇 点名的欠账：本表停在 M0，此后新增模块从未回填）：
                         方向是**反的**——`simos-actor` 依赖 util，故这里钉的是"不许反向依赖"。
                         ★ `simos-actor-api` **不在此列**：它是**契约层**（与 `economy-api` 同待遇，
                         文档明文允许被领域模块依赖），禁一个契约层没有出处。 -->
                    <exclude>io.mosire:simos-actor</exclude>
                    <!-- ★ C1（2026-10-02，D-019）：防反向依赖 calendar（依赖方向 util → map → calendar）。 -->
                    <exclude>io.mosire:simos-calendar</exclude>
                    <!-- ★★ 2026-10-12 模块语义冻结（docs/superpowers/specs/2026-10-12-module-boundaries-freeze.md §3）：
                         对称闭合 = 禁掉"本模块 + 允许面（util 为空）之外"的全部 simos 模块。
                         ★ 上方 Task 10 那段"`simos-actor-api` 不在此列（契约层）"的口径**已被本次冻结取代**
                         （原文保留作留痕）：util 零 simos 依赖 ⇒ 契约层也不再有例外。
                         ★ `simos-ledger` 已于 2026-09-27 退役、当前无同名模块：照冻结表列入，作历史留痕与未来防线。 -->
                    <exclude>io.mosire:simos-actor-api</exclude>
                    <exclude>io.mosire:simos-app</exclude>
                    <exclude>io.mosire:simos-army</exclude>
                    <exclude>io.mosire:simos-economy</exclude>
                    <exclude>io.mosire:simos-economy-api</exclude>
                    <!-- ★★ 2026-10-12 新增（设计书 docs/superpowers/specs/2026-10-12-ga-module-and-tool-descent.md
                         §4.1/§4.2）：`simos-ga-spi` 是**工具契约层**，依赖方向是 `ga-spi → util`；
                         这里钉的是**反向**——util 必须保持零 simos 依赖，否则 `util → ga-spi → util` 成环
                         ⇒ 按冻结文档 §4 I-F4 的口径列入。 -->
                    <exclude>io.mosire:simos-ga-spi</exclude>
                    <exclude>io.mosire:simos-gov</exclude>
                    <!-- ★★ 2026-10-12 B2a（设计书 §4.1 / §5 I-G2）：运行框架 simos-ga（工具运作 + 决策人运行）——
                         它永不依赖 app，其余模块也不得依赖它 ⇒ 列入禁列（组合根 simos-app 是唯一认识它的地方）。 -->
                    <exclude>io.mosire:simos-ga</exclude>
                    <exclude>io.mosire:simos-ledger</exclude>
                    <exclude>io.mosire:simos-social-api</exclude>
                    <!-- ★★ 2026-10-15 D-031 Z5（根 pom 16 → 18）：新增两模块均不在本模块允许面
                         （util 零 simos 依赖）。 -->
                    <exclude>io.mosire:simos-culture</exclude>
                    <exclude>io.mosire:simos-production</exclude>
                  </excludes>
                  <message>simos-util 是零依赖地基（地址/身份/时间/快照/变更集协议/SPI，不碰文件系统）：只许 Jackson(databind + datatype-jdk8) 与 SLF4J，不许依赖任何 simos 模块。★ 禁列 = 全仓 18 个 simos 模块 − 自己（一个不剩：含全部契约层 social-api/actor-api/economy-api/**ga-spi**、本轮 D-031 新增的 **production**/**culture**、运行框架 **ga** 与已退役的 ledger），文案与强制一致。</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
