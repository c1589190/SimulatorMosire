<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.mosire</groupId>
    <artifactId>simos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>simos-sd</artifactId>
  <name>SDSimos</name>
  <description>国家与决策人：国家归属、交战阶段与结局、决策（Directive）、判决（Verdict）、损失记录与 sd 侧 INFO。</description>

  <!-- ★ R2/R5（spec §一.2）：sd 依赖 util + map + social + unit + **agentlib-mosire**（R5 显式依赖）。
       只禁 core/app——它自己是领域模块的下游，但 core 编译期看不见它（见 simos-core 的 enforcer）。
       ★ 不得把 agentlib-mosire 写进 excludes：它正是 R5 要显式依赖的（spec §一.3 第 2 条）。 -->
  <dependencies>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-util</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-map</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-social</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-unit</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>agentlib-mosire</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId><artifactId>assertj-core</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-module-boundaries</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <!-- ★★ 2026-10-12 闭合（用户裁定「冻结各个模块的语义，确保下次改不越界」）：本仓的边界语义 = 「本模块不许**直接声明**某个依赖」；传递可见是 Maven 依赖图的事实、本模块控制不了 ⇒ 显式关掉传递检查（enforcer 3.6.3 `searchTransitive` 默认 true，字节码核实）。禁列全仓 simos 模块 − 自己 − 允许面，零例外。 -->
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                    <exclude>io.mosire:simos-core</exclude>
                    <exclude>io.mosire:simos-app</exclude>
                    <!-- ★★ 2026-10-12 模块语义冻结（docs/superpowers/specs/2026-10-12-module-boundaries-freeze.md §3）：
                         对称闭合 = 禁掉"本模块 + 允许面（util/map/social/unit）之外"的全部 simos 模块
                         （agentlib-mosire 仍按 R5 不在禁列）。★ `simos-ledger` 已退役、当前无同名模块：
                         照冻结表列入，作历史留痕与未来防线。
                         ★★ **传递依赖例外（2026-10-12 实测，三条）**：冻结表 §3 把 `actor-api` /
                         `economy-api` / `social-api` 也列进本模块禁列，但它们**加不进来**
                         （enforcer 3.6.3 `searchTransitive` 默认 true ⇒ 禁列查传递依赖）。实测链（Maven 原文）：
                             simos-sd → simos-social → simos-social-api
                             simos-sd → simos-social → simos-economy-api → simos-actor-api
                         ★ I-F2 禁止加 `<includes>` 白名单绕过 ⇒ 此处不列它们；归属由冻结表重算（另裁）。
                         ★★ 同一冻结的 §4 I-F4 比 §3 的补进列更严：`simos-actor` 不在允许面里 ⇒ 按 I-F4 一并列入
                         （sd 不声明 actor，实测 actor 不在传递闭包上）。 -->
                    <exclude>io.mosire:simos-actor</exclude>
                    <exclude>io.mosire:simos-army</exclude>
                    <exclude>io.mosire:simos-economy</exclude>
                    <exclude>io.mosire:simos-gov</exclude>
                    <!-- ★★ 2026-10-12 B2a（设计书 §4.1 / §5 I-G2）：运行框架 simos-ga（工具运作 + 决策人运行）——
                         它永不依赖 app，其余模块也不得依赖它 ⇒ 列入禁列（组合根 simos-app 是唯一认识它的地方）。 -->
                    <exclude>io.mosire:simos-ga</exclude>
                    <!-- ★★ 2026-10-12 B3 收尾：`simos-ga-spi`（工具契约层）补入禁列 —— 本模块不声明它（只可能经传递可见），而 `searchTransitive=false` 下禁列只拦直接声明 ⇒ 加它不会与传递链冲突。依据 = 台账 §7.4 的"谁声明谁除外"口径。 -->
                    <exclude>io.mosire:simos-ga-spi</exclude>
                    <exclude>io.mosire:simos-ledger</exclude>
                    <exclude>io.mosire:simos-actor-api</exclude>
                    <exclude>io.mosire:simos-calendar</exclude>
                    <exclude>io.mosire:simos-economy-api</exclude>
                    <exclude>io.mosire:simos-social-api</exclude>
                  </excludes>
                  <message>simos-sd 是**推演框架层**：决策人（dm）与推演人（gm）的总实现 —— 决策流程、权限范围、工具协议与两个工具面（2026-10-12 用户裁定语义扩张，见 docs/superpowers/specs/2026-10-12-module-boundaries-freeze.md §3）：只许依赖 util/map/social/unit（agentlib-mosire 是 R5 要显式依赖的，不在禁列）；禁列 = 全仓 simos 模块 − 自己 − 允许面（含 core/app、economy/gov/army、运行框架 ga 与已退役的 ledger）。★ 例外：social-api / calendar / economy-api / actor-api 由 social 传递带出，四条按 I-F1 不入禁列。</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
