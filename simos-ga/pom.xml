<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.mosire</groupId>
    <artifactId>simos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>simos-ga</artifactId>
  <name>GaSimos</name>
  <description>推演框架（运行流）：工具运作 + 决策人运行（LLM 回合、工具面装配、冻结回合裁决）+ 决策层效果队列（effects）。依赖 util + ga-spi + map + unit + agentlib（★ 2026-10-12 A1 起**不依赖 core**：写面一律走 ga-spi.ToolWritePort；★★ 2026-10-12 批次 3b-4 起**可依赖 map + unit**：用户裁定「那让它依赖unit呗，这不是Army模块管理的吗？照道理来说Army和Nation都得依赖Unit作为地图实体」）；宿主事实（工具名、图片通路、权限链执行）一律构造期注入，不依赖 simos-app。</description>

  <!-- ★★ 2026-10-12 新增（设计书 docs/superpowers/specs/2026-10-12-ga-module-and-tool-descent.md
       §1 用户原话 ⑤「把工具运作、决策人运行放到ga模块」/ §4.1 目标依赖图 / §4.5 ga 的内容 / §5 I-G2）：
       本模块 = **运行框架** —— "怎么跑"（工具运作 + 决策人运行），不知道"有哪些域"。
       ★ 依赖方向是单向的：`app ──▶ ga ──▶ { sd, util, ga-spi, map, unit, agentlib }`
         （★★ 2026-10-12 A1 起 **core 已摘掉**，见下方 dependency 注释与禁列里的 `io.mosire:simos-core`；
          ★★ 2026-10-12 批次 3b-4 起 **map + unit 由禁列移入允许面** —— 用户裁定见规划 §15.2 第 1 条）；
         **ga 不得依赖 simos-app**（否则 app → ga → app 成环），故凡运行流需要"宿主的东西"
         （工具名声明、权限链执行、图片通路、地图 id、宿主编排配置…）一律由构造期注入 ——
         接口定义在本模块，实现在 app。
       ★ B2a 落地"决策人运行流"那一半（§4.5 的 decision/ 四件）；工具下放（B3）、审批链与
         SimosToolSource 迁入（B2b）、决策族状态（3a/3b-1/3b-2）、效果族（3b-4）随后。 -->
  <dependencies>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-util</artifactId>
    </dependency>
    <!-- ★ 工具契约层（设计书 §4.1 的 `ga ── { 工具运作 + 决策人运行 }`）。★ A1 起它是本模块**唯一**的写面：
         9 个工具的世界写全走 `ga-spi.ToolWritePort`（适配器在 app 的组合根，见端口类注的适配规则）。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-ga-spi</artifactId>
    </dependency>
    <!-- ★★ 2026-10-12 A1（用户裁定「那让ga不依赖core就行，按你说的做」）：**本模块不再依赖 core**。
         B3 第七域下放时本模块曾真实使用 core（决策包族工具直接构造 `CommandEnvelope` 并调
         `CoreSimos.submit/submitBatch/head/replay`）；A1 把最后 9 个这样的工具（RunDecisionMakers /
         RejectDirective / SubmitPacket / SimosSdReport / ProposeCall / PacketIntent / GmMergedPlanUpsert /
         GmDecidePacket / DecisionPacketPayloads）全部改吃 `ga-spi.ToolWritePort` ⇒ 本模块**编译期再也看不见 Core**，
         与其余 8 个持状态模块同待遇（铁律 3/4 的结构化）。
         ★ 结果（2026-10-12 批次 3e 起）：依赖面 = util + ga-spi + map + unit（见下）——**`sd` 已随模块退役摘掉**；
         ★ 不成环：没有任何模块依赖 ga（15 个模块的禁列里都有它）。 -->
    <!-- ★★ 2026-10-12 批次 3e：`simos-sd` 依赖随模块退役**整条删除**（用户裁定「sd 整个弃用！」）——
         残壳里的值类型（决策人 / 决策记录 / 判决 / 决策包 / 效果 id / 载荷 / 渠道准入 / 解析器）本批**整体迁入
         本模块**（`ga.model` / `ga.id` / `ga.spi` / `ga.channel` / `ga.resolve` / `ga.adjudication`）
         ⇒ 依赖面上少一条边、内容上一个字都不少。 -->
    <!-- ★★ 2026-10-12 批次 3b-4（用户裁定，规划 §15.2 第 1 条）：**map + unit 由禁列移入允许面**。
         依据 = 用户原话「**那让它依赖unit呗，这不是Army模块管理的吗？照道理来说Army和Nation都得依赖Unit作为地图实体**」
         —— unit 是"地图实体基础设施"，map 供 `HexCoord`。
         ★ 用途只有一个但是硬需求：`Trigger.UnitAtHex(UnitId, HexCoord)`（决策层效果队列的触发条件
           `io.mosire.simos.ga.effect.Trigger`）——它的两个字段类型分别来自 unit 与 map；`TriggerEvaluator`
           求值走 `UnitState#effectivePosition`、`ga.RegisterEffect` 的存在性判据走 unit 切片。
         ⇒ 这两条边**不是破例**，是用户已批的依赖面扩张。
         ★★ 无环已核：`unit` / `map` 的 pom 都**显式声明** `simos-ga-spi`（不是 ga 本体），而**没有任何模块
           允许依赖 `simos-ga` 本体**（15 个模块的禁列里都有它）⇒ 单向无环，Maven 建图期不会成环。 -->
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-map</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>simos-unit</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId><artifactId>agentlib-mosire</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId><artifactId>assertj-core</artifactId>
    </dependency>
    <!-- ★ 2026-10-12 B3 第七域：域内窄写基类用 `@SuppressFBWarnings`（CT_CONSTRUCTOR_THROW 的既有处置形制，
         与 app/simos-map/simos-unit/simos-gov 同款）⇒ 注解依赖必须显式声明。 -->
    <dependency>
      <groupId>com.github.spotbugs</groupId><artifactId>spotbugs-annotations</artifactId>
      <version>4.10.4</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-module-boundaries</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <!-- ★★ 2026-10-12 闭合形制（照 14 个既有模块）：本仓的边界语义 = 「本模块不许**直接声明**
                       某个依赖」；传递可见是 Maven 依赖图的事实、本模块控制不了 ⇒ 显式关掉传递检查
                       （enforcer 3.6.3 的 `searchTransitive` 默认 true，逐字节码核实）。 -->
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                    <!-- ★★ A1（2026-10-12）：`core` 由**允许面移入禁列**（用户裁定「那让ga不依赖core就行」）——
                         它是本模块今天最要紧的一条"看不见"：ga 将来要持状态 + 拿 handler（批次 3a），
                         若能编译期看见 CoreSimos 的提交面，它的 handler 就能在处理中途再提交一条命令
                         （commitLock 是可重入锁 ⇒ 跑得起来、静默绕过"一条命令一条 revision"）。
                         设计书 §4.1 / §5 I-G2（**本模块的硬约束**）：允许面 = util + ga-spi + sd + map + unit
                         （+ agentlib-mosire，它不是 simos 模块故不在禁列；★★ map/unit 由批次 3b-4 按用户裁定
                         移入，见上方 dependency 注释）。禁列 = 全仓 16 个 simos 模块
                         − 自己 − 允许面 + 已退役 `simos-ledger` 留痕（`simos-sd` 本批随模块退役**整条撤出**，不留 exclude）。
                         ★ 最要紧的一条是 `simos-app`：ga 依赖 app 就是 `app → ga → app` 环（Maven 建图期直接拒），
                           也是设计书 §1 用户原话②「app只负责组装」的反面。 -->
                    <exclude>io.mosire:simos-core</exclude>
                    <exclude>io.mosire:simos-calendar</exclude>
                    <exclude>io.mosire:simos-social-api</exclude>
                    <exclude>io.mosire:simos-social</exclude>
                    <exclude>io.mosire:simos-actor-api</exclude>
                    <exclude>io.mosire:simos-actor</exclude>
                    <exclude>io.mosire:simos-economy-api</exclude>
                    <exclude>io.mosire:simos-economy</exclude>
                    <exclude>io.mosire:simos-gov</exclude>
                    <exclude>io.mosire:simos-army</exclude>
                    <exclude>io.mosire:simos-app</exclude>
                    <!-- ★ `simos-ledger` 已于 2026-09-27 退役、当前无同名模块：照冻结表列入，
                         作历史留痕与未来防线（与其余模块的禁列口径一致）。
                         ★★ 2026-10-12 批次 3e：`simos-sd` 也已整模块退役（用户裁定「sd 整个弃用！」）
                         —— 它的残壳本批整体迁入本模块 ⇒ 它从"允许面成员"变成"不存在的模块"，
                         **与 ledger 不同**：本批**不为它留 exclude**（禁列 = 全仓现存模块 − 自己 − 允许面，
                         零例外；防"同名模块被加回来"由 `ArchitectureGuardsTest` 的清单一致性判据承担）。
                         ⇒ 本模块的 `<message>` 里那句"两条留痕"随之改为只指 ledger。 -->
                    <!-- ★★ 2026-10-15 D-031 Z5（根 pom 16 → 18）：新增两模块均不在本模块允许面。 -->
                    <exclude>io.mosire:simos-culture</exclude>
                    <exclude>io.mosire:simos-production</exclude>
                    <!-- ★★ 2026-10-15 D-031 Z5 回核：上级注释与 `<message>` 都声明"含已退役 ledger 留痕"，
                         但本 pom 的 exclude **原先漏了这一条**（与其余 17 个模块的口径不一致）。
                         本批按同一冻结口径补上（ledger 不存在、无传递链，加它零风险）。 -->
                    <exclude>io.mosire:simos-ledger</exclude>
                  </excludes>
                  <message>simos-ga 是推演框架（工具运作 + 决策人运行 + 决策层效果队列 + 决策族值类型，"怎么跑"、不知道"有哪些域"）：只许依赖 simos-util / simos-ga-spi / simos-map / simos-unit（+ agentlib-mosire，不在禁列；★ map/unit 是 2026-10-12 批次 3b-4 按用户裁定「那让它依赖unit呗…Army和Nation都得依赖Unit作为地图实体」移入的，用于 Trigger.UnitAtHex(UnitId, HexCoord)）。★ 禁列 = 全仓 18 个 simos 模块 − 自己 − 允许面（含 simos-core、全部领域切片、本轮 D-031 新增的 production/culture 与已退役的 ledger 留痕；`simos-sd` 本批已整模块退役、不再是允许面成员），零例外；★ 尤其**不许依赖 simos-app**：那就是 `app → ga → app` 环（设计书 §4.1 / I-G2），宿主事实一律构造期注入。</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
