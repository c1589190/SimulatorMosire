<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.mosire</groupId>
    <artifactId>simos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>simos-actor-api</artifactId>
  <name>ActorApiSimos</name>
  <description>actor 切片共用契约：ActorRef / ActorKind / AssetKind / AssetClassKey。无 Snapshot、无存储、无领域公式。</description>

  <!-- ★ S1 阶段 2：actor-api 是全仓**最底层**的共用契约层 —— economy-api 反过来依赖它
       （actor-api ← economy-api ← {economy, ledger}）。故它**不声明任何主依赖**：
       不依赖任何 simos 领域模块、不依赖 util（三个类型与测试都零 util import，裁定 R-h 删掉该条）、
       不依赖 map（AssetHolding 要 HexCoord，但它住 simos-actor 切片）、也不依赖 jackson
       （零 import：record + Map 是 Jackson 的默认形状，用不着它，裁定 R-j 删掉该条）。 -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId><artifactId>assertj-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.spotbugs</groupId><artifactId>spotbugs-annotations</artifactId>
      <version>4.10.4</version><scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-module-boundaries</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <!-- ★★ 2026-10-12 闭合（用户裁定「冻结各个模块的语义，确保下次改不越界」）：本仓的边界语义 = 「本模块不许**直接声明**某个依赖」；传递可见是 Maven 依赖图的事实、本模块控制不了 ⇒ 显式关掉传递检查（enforcer 3.6.3 `searchTransitive` 默认 true，字节码核实）。禁列全仓 simos 模块 − 自己 − 允许面，零例外。 -->
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                    <exclude>io.mosire:simos-economy-api</exclude>
                    <exclude>io.mosire:simos-economy</exclude>
                    <exclude>io.mosire:simos-social</exclude>
                    <exclude>io.mosire:simos-unit</exclude>
                    <exclude>io.mosire:simos-sd</exclude>
                    <exclude>io.mosire:simos-core</exclude>
                    <exclude>io.mosire:simos-app</exclude>
                    <!-- ★★ 2026-10-12 模块语义冻结（文档 §3）：对称闭合
                         = 禁掉"本模块 + 允许面（空）之外"的全部 simos 模块（本批补 `util` 与 `ledger`）。
                         ★ `simos-ledger` 已退役、当前无同名模块：照冻结表列入，作历史留痕与未来防线。
                         ★★ 同一冻结的 §4 I-F4 比 §3 的补进列更严：`actor` / `army` / `calendar` / `gov` /
                         `map` / `social-api` 也不在允许面里 ⇒ 按 I-F4 一并列入。本模块主依赖为零、
                         传递闭包为空（实测），故这 6 条全部加得进来（§3 只点了 util/ledger，是漏列）。 -->
                    <exclude>io.mosire:simos-actor</exclude>
                    <exclude>io.mosire:simos-army</exclude>
                    <exclude>io.mosire:simos-calendar</exclude>
                    <exclude>io.mosire:simos-gov</exclude>
                    <exclude>io.mosire:simos-map</exclude>
                    <exclude>io.mosire:simos-social-api</exclude>
                    <exclude>io.mosire:simos-util</exclude>
                    <exclude>io.mosire:simos-ledger</exclude>
                    <exclude>io.mosire:agentlib-mosire</exclude>
                  </excludes>
                  <message>simos-actor-api 是 actor 切片最底层的共用契约（ActorRef/ActorKind/AssetKind/AssetClassKey；主依赖为零、零 simos import）：不声明任何 simos 依赖 ⇒ 禁列 = 全仓其他 14 个 simos 模块全部（含 util/map 与全部契约层、已退役的 ledger），一个口子都不留。</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
