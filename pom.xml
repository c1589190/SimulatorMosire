<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- 不继承 io.mosire:mosire-parent：避免连带继承其 dependencyManagement
       与插件配置（spec §10.3 G5）。依赖版本一律在本 POM 显式声明。 -->
  <groupId>io.mosire</groupId>
  <artifactId>simos-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>SimulatorMosire</name>
  <description>多模块模拟引擎：UtilSimos / MapSimos / SocialApiSimos / SocialSimos / UnitSimos / CoreSimos / SDSimos / ActorApiSimos / ActorSimos / EconomyApiSimos / EconomySimos / GovSimos / ArmySimos / SimosApp（组合根）。各模块的边界与允许依赖见 AGENTS.md 的表。</description>

  <modules>
    <module>simos-util</module>
    <!-- ★★ 2026-10-12 新增（设计书 docs/superpowers/specs/2026-10-12-ga-module-and-tool-descent.md
         §4.1 目标依赖图 / §4.2 内容表）：**工具契约层** —— SimosTool 工具接口 + ToolRole 角色标签 +
         GmOnlyRead 标签 + ToolWritePort 窄写口 + ToolResources/ToolSchema 纯助手。
         它紧贴 util 之上，只依赖 util + agentlib-mosire，**不依赖 core**（core 的 test scope 依赖
         map/social/unit ⇒ 会成环）；各域模块的工具实现依赖它（B3），运行框架 simos-ga 依赖它（B2）。 -->
    <module>simos-ga-spi</module>
    <module>simos-map</module>
    <module>simos-calendar</module>
    <!-- ★ 阶段 S1（2026-10-09 家户/人口计划）：social 切片共用的低层人口/家户身份契约
         （HouseholdId / PeopleLotId / Sex / 家户画像 / 人口事件与率 / 只读 SPI）。
         只依赖 map + jackson-annotations（类型注解），不依赖任何领域模块；排在 simos-social 之前。
         ★ 方案 A（2026-10-09 用户裁定）：保留它是为了让 economy-api / actor 等更上游契约可依赖它，
         破 social ↔ economy-api 环；业务模块对 Social 的直连走 simos-social 实现。 -->
    <module>simos-social-api</module>
    <module>simos-social</module>
    <module>simos-unit</module>
    <module>simos-core</module>
    <!-- ★★ 2026-10-12 批次 3e：`simos-sd` **整模块退役**（用户裁定「sd 整个弃用！」＋「sd:nation.<id>
         地址族 → 直接扔」）——它的 14 个组件早已按族交清（决策族 7 → ga / 外交 3 → gov / 战斗 4 → army），
         最后一批把残壳（0 组件状态、0 键 codec、解析器、载荷、渠道准入）拆完 ⇒ 模块与它的 `<module>` 行一并消失。
         ★ 本行**有意不留痕**：`<module>` 是构建面，留着就是"模块还在"（与 `simos-ledger` 只在 enforcer 禁列留痕的
         处置不同——那条是防"有人再把同名模块加回来"，由其余 16 个 pom 的禁列承担）。 -->
    <!-- ★ S1 阶段 2：actor 切片共用契约（ActorRef / ActorKind / AssetKind / AssetClassKey）。
         它在依赖图上比 economy-api 更底层（economy-api 反过来依赖本模块），故排在 economy-api 之
         前：不声明主依赖（util / map / jackson 都不声明），不被任何领域模块**反向**依赖。 -->
    <module>simos-actor-api</module>
    <!-- ★ S1 阶段 2（C 段）：actor 切片——Actor 身份本体 + 产权/库存（本任务只建 Actor 身份与状态树骨架）。
         它依赖 actor-api（ActorRef）与 util（Snapshot/ChangeSet/FieldDelta），故排在 actor-api **之后**；
         与 economy 是**兄弟切片**（互不依赖，由本模块 pom 的 enforcer 在构建期强制）。 -->
    <module>simos-actor</module>
    <!-- ★ 1b-2：经济切片共用契约。在领域切片更上游：只依赖 actor-api/util/map、不被 core 依赖，
         property/production/market/government 与 social 共用它的稳定 ID。
         ★ **ActorRef 不在这份清单里**（它住在上面的 `simos-actor-api`，比本模块还底层）——本模块只**引用**它
         （`LaborAllocation.actor`），**不拥有**定义。 -->
    <module>simos-economy-api</module>
    <!-- ★ R1（2026-09-25 新经济设计）：聚合式社会经济切片骨架——产业表/阶层行/债务表/周期流水 + 激活元信息，
         **无公式**（§八 R1 行）。依赖 util/economy-api/map/actor-api/social-api，并按方案 A（2026-10-09）
         直连 social（人员/家户唯一域）；不被 core 依赖。
         后续 R2+ 的结算逻辑（人口→阶层、日/周期结算、税、市场）在本切片内续做。 -->
    <module>simos-economy</module>
    <!-- ★ 阶段 10a（2026-09-30 GOV/Army 计划 §2.2）：行政切片骨架——每 tick 行政读数（GovOfficeState）
         + 落盘切片/变更集/编解码。只依赖 util/map/unit/social/economy-api（本阶段只用 unit/economy-api 的类型），
         **不得依赖 core/app**（铁律 3：领域模块不认识组合与调度）。 -->
    <module>simos-gov</module>
    <!-- ★ 阶段 12（2026-10-01 用户裁定 6/8）+ 方案 A（2026-10-09）：军队切片——一期只把“辖区 = 视野”
         做成纯派生视图（ArmyVision），不落盘、不算战力；方案 A 起允许直连 simos-social（人员/家户唯一域），
         连同 util/map/unit 一起是显式依赖面；仍不得依赖 sd/economy/actor/app/core 实现。 -->
    <module>simos-army</module>
    <!-- ★★ 2026-10-12 新增（设计书 docs/superpowers/specs/2026-10-12-ga-module-and-tool-descent.md
         §1 用户原话 ⑤ / §4.1 目标依赖图 / §4.5 内容表）：**运行框架** —— 工具运作 + 决策人运行。
         它依赖 core + sd + util + ga-spi + agentlib，**永不依赖 simos-app**（否则 app → ga → app 成环）；
         凡运行流需要"宿主的东西"（工具名声明、权限链执行、图片通路…）一律构造期注入（接口在 ga、实现在 app）。
         排在组合根 simos-app 之前：app 是唯一认识本模块的地方（"app 只负责组装"）。 -->
    <module>simos-ga</module>
    <!-- ★ M5 T1：组合根。依赖全部领域模块 + AgentLib/MCP，是 reactor 末位；
         它不被任何模块依赖（父 POM 不引它 ⇒ 无反向依赖）。不设 enforcer（spec §2.2）。 -->
    <module>simos-app</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <jackson.version>2.22.2</jackson.version>
    <slf4j.version>2.0.19</slf4j.version>
    <sqlite-jdbc.version>3.53.4.0</sqlite-jdbc.version>
    <log4j.version>2.26.1</log4j.version>
    <mcp.sdk.version>2.0.1</mcp.sdk.version>
    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>

    <!-- ★★ 2026-10-14 改为固定版本（接入指南 §2.1 方法 B）。当初用 SNAPSHOT：用户 2026-09-16 裁决
         "暂缓升固定版本"——当时 ProjectMosire 有在途工作、且尚无公开发布可用，决策原话是等在途工作
         落地后再升固定版本。**如今在途工作已落地**（R8 的 doc_guide / workspace_info 等新工具就随
         首个公开发布 0.1.0 一并发出），用户 2026-10-14 指示改走**远程仓库 + 固定版本** ⇒
         不再依赖本机 ~/.m2 里拷来的 SNAPSHOT（跨机器可重建、不需要凭据）。
         本条属性是这三个库版本的**唯一拼写点**（simos-app 亦引它）。
         ★★ 2026-10-17 升级 0.1.0 → 0.2.1（分支 agentlib/dock-0.2.1）：0.2.1 新增
         io.mosire.agentlib.runtime（AgentLoop 等 8 类）/ context（ContextWindow 等 3 类）/
         agent.AgentConfig，并给 AgentTool 加了角色维 roles()——本分支正是为了「ga 的 Agent 实现
         改为复用这些标准件」，详见 docs/superpowers/specs/ 下本分支设计书。 -->
    <agentlib-mosire.version>0.2.3-SNAPSHOT</agentlib-mosire.version>

    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <spotless.version>3.10.2</spotless.version>
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <spotbugs-maven-plugin.version>4.10.4.1</spotbugs-maven-plugin.version>
  </properties>

  <!-- ★★ 2026-10-14 新增（接入指南 §2.1「远程仓库（GitHub Pages，公开、消费方零认证）」/ 方法 B）：
       io.mosire 三库的**固定版本**从隔壁 ProjectMosire 发到 GitHub Pages 的公开仓库取 —— 不需要本机
       ~/.m2、不需要凭据、跨机器可用（模块 POM 不重复写，Maven 仓库配置对全 reactor 生效）。
       ★ 只发固定版本：SNAPSHOT 不发 Pages（文件被覆盖就不可复现）⇒ snapshots 必须关。 -->
  <repositories>
    <repository>
      <id>mosire-pages</id>
      <url>https://c1589190.github.io/ProjectMosire/</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <dependencyManagement>
    <dependencies>
      <!-- 本仓五模块：版本集中在此，模块 POM 不再重复写 -->
      <dependency>
        <groupId>io.mosire</groupId><artifactId>simos-util</artifactId><version>${project.version}</version>
      </dependency>
      <!-- ★★ 2026-10-12 新增（设计书 §4.1/§4.2）：工具契约层。与其余模块同款在此集中版本，
           模块 POM 不再重复写（B2/B3 的工具实现与运行框架都依赖它）。 -->
      <dependency>
        <groupId>io.mosire</groupId><artifactId>simos-ga-spi</artifactId><version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.mosire</groupId><artifactId>simos-map</artifactId><version>${project.version}</version>
      </dependency>
      <!-- ★ C4a（2026-10-02）：app 的日推进/危机读口要按历法年折算衣着，直接依赖纯计算模块 calendar；
           与 gov 不同——gov 只在 settle 收调用方传入的年长（365/366），不新增 calendar 依赖。 -->
      <dependency>
        <groupId>io.mosire</groupId><artifactId>simos-calendar</artifactId><version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.mosire</groupId><artifactId>simos-social-api</artifactId><version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.mosire</groupId><artifactId>simos-social</artifactId><version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.mosire</groupId><artifactId>simos-unit</artifactId><version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.mosire</groupId><artifactId>simos-core</artifactId><version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.mosire</groupId><artifactId>simos-actor-api</artifactId><version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.mosire</groupId><artifactId>simos-actor</artifactId><version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.mosire</groupId><artifactId>simos-economy-api</artifactId><version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.mosire</groupId><artifactId>simos-economy</artifactId><version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.mosire</groupId><artifactId>simos-gov</artifactId><version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.mosire</groupId><artifactId>simos-army</artifactId><version>${project.version}</version>
      </dependency>
      <!-- ★★ 2026-10-12 新增（设计书 §4.1/§4.5）：运行框架（工具运作 + 决策人运行）。
           与其余模块同款在此集中版本；**唯一**声明它的是组合根 simos-app（其余模块一律禁）。 -->
      <dependency>
        <groupId>io.mosire</groupId><artifactId>simos-ga</artifactId><version>${project.version}</version>
      </dependency>

      <!-- 外部依赖 -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId><artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version><type>pom</type><scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.modelcontextprotocol.sdk</groupId><artifactId>mcp-bom</artifactId>
        <version>${mcp.sdk.version}</version><type>pom</type><scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId><version>${sqlite-jdbc.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId><artifactId>log4j-core</artifactId><version>${log4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId><artifactId>log4j-slf4j2-impl</artifactId><version>${log4j.version}</version>
      </dependency>
      <dependency>
        <groupId>io.mosire</groupId><artifactId>agentlib-mosire</artifactId>
        <version>${agentlib-mosire.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version><scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId><artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version><scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <googleJavaFormat/>
            </java>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${maven-checkstyle-plugin.version}</version>
          <configuration>
            <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle.xml</configLocation>
            <consoleOutput>true</consoleOutput>
            <failOnViolation>true</failOnViolation>
          </configuration>
        </plugin>
        <plugin>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <version>${spotbugs-maven-plugin.version}</version>
          <configuration>
            <effort>More</effort>
            <threshold>Low</threshold>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-java-and-maven</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[21,)</version></requireJavaVersion>
                <requireMavenVersion><version>[3.8,)</version></requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- 门禁三件套：格式 / 静态风格 / 缺陷扫描。
           版本与规则配置锚定在上方 pluginManagement，此处只接 execution。 -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>spotless-check</id>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <executions>
          <execution>
            <id>checkstyle-check</id>
            <phase>validate</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
      <!-- 768m/30min：本机内存下 effort=More 的分析进程会被换页拖慢，撞上插件默认 60s 超时。
             二者是 spotbugs **目标**的参数，而 check 目标执行前会先调用它，故门禁同样生效。
             注：4.10.x 已移除 `fork` 参数，原样照搬 ProjectMosire pom.xml:278 会得到
             "Parameter 'fork' is unknown" 警告且该行完全无效——故此处不写。 -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <configuration>
          <maxHeap>768</maxHeap>
          <timeout>1800000</timeout>
        </configuration>
        <executions>
          <execution>
            <id>spotbugs-check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
